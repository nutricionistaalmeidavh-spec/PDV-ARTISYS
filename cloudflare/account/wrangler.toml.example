name = "artisys-account"
main = "src/worker.mjs"
compatibility_date = "2026-09-25"

[[d1_databases]]
binding = "artisys"
database_name = "REPLACE_WITH_EXISTING_D1_NAME"
database_id = "REPLACE_WITH_EXISTING_D1_DATABASE_ID"
migrations_dir = "migrations"

[[send_email]]
name = "EMAIL"

[vars]
EMAIL_FROM = "noreply@REPLACE_WITH_ONBOARDED_DOMAIN"
