name = "pdv-artisys"
main = "src/worker.mjs"
compatibility_date = "2026-10-03"
keep_vars = true

[[d1_databases]]
binding = "artisys"
database_name = "artisys"
database_id = "REPLACE_WITH_EXISTING_D1_DATABASE_ID"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "artisysr2"
bucket_name = "artisyspdv"

# O fluxo de licenca e manual: a Central gera o codigo e o administrador
# envia o codigo ao cliente. Nao ha binding de e-mail neste Worker.
