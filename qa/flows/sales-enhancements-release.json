{
  "name": "sales-enhancements-release",
  "steps": [
    {"uses":"home.json"},

    {"action":"click","selector":"[data-home-route='sellers']","name":"open-sellers"},
    {"action":"waitFor","selector":"#new-seller","name":"sellers-ready","timeoutMs":10000},
    {"action":"click","selector":"#new-seller","name":"new-seller"},
    {"action":"fill","selector":"#seller-form input[name='name']","value":"QA Vendedor Release","name":"seller-name"},
    {"action":"fill","selector":"#seller-form input[name='username']","value":"qavendedorrelease","name":"seller-username"},
    {"action":"fill","selector":"#seller-form input[name='password']","value":"QaSellerRelease-12345!","name":"seller-password"},
    {"action":"click","selector":"#seller-form button[type='submit']","name":"save-seller"},
    {"action":"expectText","selector":".data-card","expected":"QA Vendedor Release","name":"seller-created"},

    {"action":"click","selector":"[data-route='products']","name":"open-products"},
    {"action":"waitFor","selector":"#new-product","name":"products-ready","timeoutMs":10000},
    {"action":"click","selector":"#new-product","name":"new-product"},
    {"action":"fill","selector":"#product-form input[name='name']","value":"QA Produto Release","name":"product-name"},
    {"action":"fill","selector":"#product-form input[name='sku']","value":"QA-REL-001","name":"product-sku"},
    {"action":"fill","selector":"#product-form input[name='salePrice']","value":"10,00","name":"product-price"},
    {"action":"fill","selector":"#product-form input[name='cost']","value":"5,00","name":"product-cost"},
    {"action":"uncheck","selector":"#product-form input[name='trackStock']","name":"product-no-stock-control"},
    {"action":"click","selector":"#product-form button[type='submit']","name":"save-product"},
    {"action":"expectText","selector":".data-card:not([data-kit-combo-admin])","expected":"QA Produto Release","name":"product-created"},
    {"action":"expectVisible","selector":"[data-product-photo-edit]","name":"product-photo-control"},

    {"action":"click","selector":"[data-route='reports']","name":"open-reports-for-commission"},
    {"action":"waitFor","selector":"#reports-commission-rule","name":"commission-form-ready","timeoutMs":10000},
    {"action":"selectOption","selector":"#reports-commission-rule select[name='sellerId']","value":{"label":"QA Vendedor Release"},"name":"commission-seller"},
    {"action":"fill","selector":"#reports-commission-rule input[name='percent']","value":"5","name":"commission-percent"},
    {"action":"click","selector":"#reports-commission-rule button[type='submit']","name":"save-commission-rule"},
    {"action":"waitFor","selector":"#reports-commission-rule","name":"commission-form-restored","timeoutMs":10000},
    {"action":"expectText","selector":".reports-page","expected":"5%","name":"commission-rule-created"},

    {"action":"click","selector":"[data-route='checkout']","name":"open-checkout"},
    {"action":"waitFor","selector":"#seller-select","name":"checkout-ready","timeoutMs":10000},
    {"action":"selectOption","selector":"#seller-select","value":{"label":"QA Vendedor Release"},"name":"seller-selected"},
    {"action":"click","selector":".product-card:has-text('QA Produto Release')","name":"add-product-to-sale"},
    {"action":"waitFor","selector":".cart-line","name":"cart-item-ready","timeoutMs":10000},
    {"action":"fill","selector":"#sale-observation","value":"QA observação release persistida","name":"sale-observation-filled"},
    {"action":"check","selector":"#sale-observation-print","name":"sale-observation-print"},
    {"action":"click","selector":"[data-price-item]","name":"open-price-override"},
    {"action":"waitFor","selector":"#price-override-form","name":"price-override-ready","timeoutMs":10000},
    {"action":"fill","selector":"#price-override-form input[name='unitPrice']","value":"9,50","name":"override-price"},
    {"action":"fill","selector":"#price-override-form textarea[name='reason']","value":"QA ajuste release","name":"override-reason"},
    {"action":"click","selector":"#price-override-form button[type='submit']","name":"apply-price-override"},
    {"action":"waitFor","selector":"#price-override-form","state":"detached","name":"price-modal-closed","timeoutMs":10000},
    {"action":"expectText","selector":".cart-line","expected":"QA ajuste release","name":"price-override-applied"},

    {"action":"click","selector":"#finalize-sale","name":"start-finalization"},
    {"action":"waitFor","selector":"#initial-cash","name":"cash-open-required","timeoutMs":10000},
    {"action":"fill","selector":"#initial-cash","value":"0,00","name":"cash-initial-value"},
    {"action":"click","selector":"#confirm-open-cash","name":"open-cash"},
    {"action":"waitFor","selector":"#confirm-payment","name":"payment-ready","timeoutMs":10000},
    {"action":"click","selector":"#confirm-payment","name":"confirm-payment"},
    {"action":"waitForTimeout","timeoutMs":800,"name":"sale-completed"},

    {"action":"click","selector":"#sidebar-nav [data-route='home']","name":"back-home"},
    {"action":"waitFor","selector":"[data-home-route='sales']","name":"sales-home-ready","timeoutMs":10000},
    {"action":"click","selector":"[data-home-route='sales']","name":"open-sales-history"},
    {"action":"waitFor","selector":"[data-sale-details]","name":"sale-history-ready","timeoutMs":10000},
    {"action":"click","selector":"[data-sale-details]","name":"open-sale-details"},
    {"action":"waitFor","selector":"#ops-sale-detail .ops-card","name":"sale-detail-ready","timeoutMs":10000},
    {"action":"expectText","selector":"#ops-sale-detail","expected":"QA observação release persistida","name":"sale-history-observation"},
    {"action":"expectText","selector":"#ops-sale-detail","expected":"QA ajuste release","name":"sale-history-price-override"},

    {"action":"click","selector":"[data-route='reports']","name":"open-final-reports"},
    {"action":"waitFor","selector":"#reports-filter","name":"reports-ready","timeoutMs":10000},
    {"action":"fill","selector":"#reports-filter input[name='fromDate']","value":"2020-01-01","name":"report-from"},
    {"action":"fill","selector":"#reports-filter input[name='toDate']","value":"2099-12-31","name":"report-to"},
    {"action":"selectOption","selector":"#reports-filter select[name='sellerId']","value":{"label":"QA Vendedor Release"},"name":"report-seller-filter"},
    {"action":"click","selector":"#reports-filter button[type='submit']","name":"apply-report-filter"},
    {"action":"waitForTimeout","timeoutMs":500,"name":"report-refresh"},
    {"action":"expectText","selector":".reports-page","expected":"QA Vendedor Release","name":"reports-period-and-seller"},
    {"action":"expectText","selector":".reports-page","expected":"Comissões por vendedor / garçom","name":"reports-commission-section"},
    {"action":"screenshot","name":"sales-enhancements-release","fullPage":true}
  ]
}
