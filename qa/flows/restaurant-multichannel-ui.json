{
  "name": "restaurant-multichannel-ui",
  "title": "ArtiSys PDV — pedidos reais em garçom, tablet e QR",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "bootstrap",
      "timeoutMs": 15000
    },
    {
      "action": "fill",
      "selector": "#login-form input[name='username']",
      "value": "qaadmin",
      "name": "usuario-qa"
    },
    {
      "action": "fill",
      "selector": "#login-form input[name='password']",
      "value": "QaLocalOnly-12345!",
      "name": "senha-qa"
    },
    {
      "action": "click",
      "selector": "#login-form button[type='submit']",
      "name": "entrar",
      "holdMs": 300
    },
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "autenticado",
      "state": "hidden",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "restaurant.channels.setup"
    },
    {
      "action": "goto",
      "url": "http://127.0.0.1:4174/mobile",
      "name": "abrir-mobile"
    },
    {
      "action": "capability",
      "name": "restaurant.channels.loginWaiter"
    },
    {
      "action": "waitFor",
      "selector": ".staff-head",
      "name": "garcom-carregado",
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "click",
      "selector": "[data-table='qa-channel-waiter']",
      "name": "selecionar-mesa-garcom",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#open-table-form",
      "name": "form-abrir-garcom",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "fill",
      "selector": "#open-table-form input[name='partySize']",
      "value": "4",
      "name": "garcom-pessoas"
    },
    {
      "action": "selectOption",
      "selector": "#open-table-form select[name='customerId']",
      "value": "qa-channel-customer",
      "name": "garcom-cliente"
    },
    {
      "action": "click",
      "selector": "#open-table",
      "name": "garcom-abrir-mesa",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "[data-add='qa-channel-product']",
      "name": "garcom-produto",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "[data-add='qa-channel-product']",
      "name": "garcom-configurar-item",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#mobile-product-config",
      "name": "garcom-config-modal",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "check",
      "selector": "#mobile-product-config [data-option][value='qa-channel-option']",
      "name": "garcom-opcao"
    },
    {
      "action": "fill",
      "selector": "#mobile-product-config textarea[name='note']",
      "value": "garcom QA",
      "name": "garcom-observacao"
    },
    {
      "action": "click",
      "selector": "#mobile-product-config button[type='submit']",
      "name": "garcom-adicionar",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": ".cart-line:has-text('QA Channel Burger')",
      "name": "garcom-carrinho",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "#send-order",
      "name": "garcom-enviar",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": ".selected-table:has-text('Novo')",
      "name": "garcom-pedido-novo",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "screenshot",
      "name": "01-garcom-pedido-configurado",
      "fullPage": true
    },
    {
      "action": "capability",
      "name": "restaurant.channels.loginTablet"
    },
    {
      "action": "waitFor",
      "selector": ".staff-head h1:has-text('QA Mesa Tablet')",
      "name": "tablet-carregado",
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "click",
      "selector": "[data-add='qa-channel-product']",
      "name": "tablet-configurar-item",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#mobile-product-config",
      "name": "tablet-config-modal",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "check",
      "selector": "#mobile-product-config [data-option][value='qa-channel-option']",
      "name": "tablet-opcao"
    },
    {
      "action": "fill",
      "selector": "#mobile-product-config textarea[name='note']",
      "value": "tablet QA",
      "name": "tablet-observacao"
    },
    {
      "action": "click",
      "selector": "#mobile-product-config button[type='submit']",
      "name": "tablet-adicionar",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": ".cart-line:has-text('QA Channel Burger')",
      "name": "tablet-carrinho",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "#send-order",
      "name": "tablet-enviar",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": ".order-row:has-text('QA Channel Burger')",
      "name": "tablet-pedido-historico",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "screenshot",
      "name": "02-tablet-pedido-configurado",
      "fullPage": true
    },
    {
      "action": "capability",
      "name": "restaurant.channels.openQr"
    },
    {
      "action": "waitFor",
      "selector": "[data-product='qa-channel-product']",
      "name": "qr-cardapio",
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "click",
      "selector": "[data-product='qa-channel-product']",
      "name": "qr-configurar-item",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#product-dialog",
      "name": "qr-config-modal",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "check",
      "selector": "#product-form [data-option][value='qa-channel-option']",
      "name": "qr-opcao"
    },
    {
      "action": "fill",
      "selector": "#product-form textarea[name='note']",
      "value": "QR QA",
      "name": "qr-observacao"
    },
    {
      "action": "click",
      "selector": "#product-form button[type='submit']",
      "name": "qr-adicionar",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#cart-rail",
      "name": "qr-carrinho-rail",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "#review-cart",
      "name": "qr-revisar",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#send-order",
      "name": "qr-enviar-visivel",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "#send-order",
      "name": "qr-enviar",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#table-orders .order-row:has-text('QA Channel Burger')",
      "name": "qr-pedido-historico",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "screenshot",
      "name": "03-qr-pedido-configurado",
      "fullPage": true
    },
    {
      "action": "capability",
      "name": "restaurant.channels.assert"
    },
    {
      "action": "capability",
      "name": "restaurant.channels.teardown"
    },
    {
      "action": "expectNoHorizontalOverflow",
      "selector": "body",
      "name": "canais-sem-overflow",
      "tolerancePx": 4,
      "timeoutMs": 10000
    }
  ]
}
