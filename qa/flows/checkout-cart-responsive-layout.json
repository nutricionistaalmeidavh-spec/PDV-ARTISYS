    {"action":"click","selector":"[data-price-item]","name":"responsive-open-price-override"},
    {"action":"waitFor","selector":"#price-override-form","name":"responsive-price-override-ready","timeoutMs":10000},
    {"action":"fill","selector":"#price-override-form input[name='unitPrice']","value":"9,50","name":"responsive-override-price"},
    {"action":"fill","selector":"#price-override-form textarea[name='reason']","value":"QA ajuste responsivo","name":"responsive-override-reason"},
    {"action":"click","selector":"#price-override-form button[type='submit']","name":"responsive-apply-price-override"},
    {"action":"waitFor","selector":"#price-override-form","state":"detached","name":"responsive-price-modal-closed","timeoutMs":10000},
    {"action":"expectText","selector":".cart-line","expected":"QA ajuste responsivo","name":"responsive-price-override-applied"},
    {"action":"expectVisible","selector":".cart-line .qty-control","name":"responsive-quantity-visible"},
    {"action":"expectVisible","selector":".cart-line .line-total","name":"responsive-total-visible"},
    {"action":"expectNoHorizontalOverflow","selector":".cart-line","tolerancePx":2,"name":"responsive-cart-line-no-overflow"},
    {"action":"expectNoHorizontalOverflow","selector":".sale-panel","tolerancePx":2,"name":"responsive-sale-panel-no-overflow"},
    {"action":"screenshot","name":"checkout-cart-responsive-1366x768","fullPage":true}
