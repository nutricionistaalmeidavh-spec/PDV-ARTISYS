{
  "name": "checkout-cart-responsive-layout",
  "steps": [
    {"action":"waitFor","selector":"#setup-form","name":"responsive-setup-ready","timeoutMs":15000},
    {"action":"fill","selector":"#setup-form input[name='name']","value":"QA Administrador","name":"responsive-setup-admin-name"},
    {"action":"fill","selector":"#setup-form input[name='username']","value":"qaadmin","name":"responsive-setup-admin-username"},
    {"action":"fill","selector":"#setup-form input[name='password']","value":"QaLocalOnly-12345!","name":"responsive-setup-admin-password"},
    {"action":"click","selector":"#setup-form button[type='submit']","name":"responsive-admin-setup"},
    {"action":"waitFor","selector":"#login-form","name":"responsive-login-ready","timeoutMs":10000},
    {"action":"fill","selector":"#login-form input[name='username']","value":"qaadmin","name":"responsive-login-username"},
    {"action":"fill","selector":"#login-form input[name='password']","value":"QaLocalOnly-12345!","name":"responsive-login-password"},
    {"action":"click","selector":"#login-form button[type='submit']","name":"responsive-login"},
    {"action":"waitFor","selector":"#auth-overlay","state":"hidden","name":"responsive-authenticated","timeoutMs":10000},
    {"action":"click","selector":"[data-route='products']","name":"responsive-open-products"},
    {"action":"waitFor","selector":"#new-product","name":"responsive-products-ready","timeoutMs":10000},
    {"action":"click","selector":"#new-product","name":"responsive-new-product"},
    {"action":"fill","selector":"#product-form input[name='name']","value":"QA Produto UltraLongoSemQuebraParaValidarCarrinhoResponsivo1366x768","name":"responsive-product-name"},
    {"action":"fill","selector":"#product-form input[name='sku']","value":"QA-RSP-001","name":"responsive-product-sku"},
    {"action":"fill","selector":"#product-form input[name='salePrice']","value":"10,00","name":"responsive-product-price"},
    {"action":"fill","selector":"#product-form input[name='cost']","value":"5,00","name":"responsive-product-cost"},
    {"action":"uncheck","selector":"#product-form input[name='trackStock']","name":"responsive-product-no-stock"},
    {"action":"click","selector":"#product-form button[type='submit']","name":"responsive-save-product"},
    {"action":"expectText","selector":".data-card","expected":"QA Produto UltraLongoSemQuebraParaValidarCarrinhoResponsivo1366x768","name":"responsive-product-created"},
    {"action":"setViewportSize","width":1366,"height":768,"name":"responsive-viewport-1366x768"},
    {"action":"click","selector":"[data-route='checkout']","name":"responsive-open-checkout"},
    {"action":"waitFor","selector":".checkout-layout","name":"responsive-checkout-ready","timeoutMs":10000},
    {"action":"click","selector":".product-card[data-add-product]:has-text('QA Produto UltraLongoSemQuebraParaValidarCarrinhoResponsivo1366x768')","name":"responsive-add-long-product"},
    {"action":"waitFor","selector":".cart-line","name":"responsive-cart-line-ready","timeoutMs":10000},
