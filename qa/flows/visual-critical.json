{
  "name": "visual-critical",
  "description": "Prepara onboarding apenas para o gate visual e valida estados críticos estáveis.",
  "steps": [
    {"action":"waitFor","selector":"#first-access-form","name":"visual-first-access-ready","timeoutMs":15000},
    {"action":"fill","selector":"#first-access-form input[name='name']","value":"QA Visual","name":"visual-setup-admin-name"},
    {"action":"fill","selector":"#first-access-form input[name='username']","value":"qavisual","name":"visual-setup-admin-username"},
    {"action":"fill","selector":"#first-access-form input[name='password']","value":"QaHomeLocal-12345!","name":"visual-setup-admin-password"},
    {"action":"fill","selector":"#first-access-form input[name='passwordConfirm']","value":"QaHomeLocal-12345!","name":"visual-setup-admin-password-confirm"},
    {"action":"click","selector":"#first-access-form button[type='submit']","name":"visual-admin-setup-and-login"},
    {"action":"waitFor","selector":"#auth-overlay","state":"hidden","name":"visual-authenticated","timeoutMs":10000},
    {"action":"waitFor","selector":"#app-topbar","name":"visual-app-ready","timeoutMs":15000},
    {"action":"desktopApiRequest","path":"/api/v1/vertical/onboarding/complete","method":"POST","body":{"businessName":"QA Visual","segment":"GENERIC","moduleIds":[]},"expectedStatus":200,"name":"visual-complete-onboarding"},
    {"action":"click","selector":"#sidebar-nav [data-route='home']","name":"visual-open-home"},
    {"action":"waitFor","selector":"#classic-home-grid[data-home-role='admin']","name":"visual-canonical-home-ready","timeoutMs":10000},
    {"action":"visualSnapshot","selector":"#classic-home-grid","snapshot":"classic-home-critical","maxDiffRatio":0.003,"name":"classic-home-visual-regression"},
    {"action":"click","selector":"#classic-home-grid [data-classic-route='checkout']","name":"visual-open-checkout"},
    {"action":"waitFor","selector":".checkout-layout","name":"visual-checkout-ready","timeoutMs":10000},
    {"action":"visualSnapshot","selector":".checkout-layout","snapshot":"checkout-critical","maxDiffRatio":0.003,"name":"checkout-visual-regression"}
  ]
}
