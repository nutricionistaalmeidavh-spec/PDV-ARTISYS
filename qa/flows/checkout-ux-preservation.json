{
  "name":"checkout-ux-preservation",
  "steps":[
    {"uses":"home.json"},

    {"action":"click","selector":"[data-route='products']","name":"ux-open-products"},
    {"action":"waitFor","selector":"#new-product","name":"ux-products-ready","timeoutMs":10000},
    {"action":"click","selector":"#new-product","name":"ux-new-product"},
    {"action":"fill","selector":"#product-form input[name='name']","value":"QA UX Balcao","name":"ux-product-name"},
    {"action":"fill","selector":"#product-form input[name='sku']","value":"QA-UX-BALCAO","name":"ux-product-sku"},
    {"action":"fill","selector":"#product-form input[name='salePrice']","value":"100,00","name":"ux-product-price"},
    {"action":"fill","selector":"#product-form input[name='cost']","value":"50,00","name":"ux-product-cost"},
    {"action":"uncheck","selector":"#product-form input[name='trackStock']","name":"ux-product-no-stock-control"},
    {"action":"click","selector":"#product-form button[type='submit']","name":"ux-save-product"},
    {"action":"expectText","selector":".data-card:not([data-kit-combo-admin])","expected":"QA UX Balcao","name":"ux-product-created"},

    {"action":"click","selector":"[data-route='customers']","name":"ux-open-customers"},
    {"action":"waitFor","selector":"#new-customer","name":"ux-customers-ready","timeoutMs":10000},
    {"action":"click","selector":"#new-customer","name":"ux-new-customer"},
    {"action":"fill","selector":"#customer-form input[name='name']","value":"QA Cliente Balcao","name":"ux-customer-name"},
    {"action":"click","selector":"#customer-form button[type='submit']","name":"ux-save-customer"},
    {"action":"expectText","selector":".data-card","expected":"QA Cliente Balcao","name":"ux-customer-created"},

    {"action":"click","selector":"[data-route='checkout']","name":"ux-open-checkout"},
    {"action":"waitFor","selector":".checkout-layout[data-ux-checkout-preserved='true']","name":"ux-checkout-ready","timeoutMs":10000},
    {"action":"expectVisible","selector":"#product-search","name":"ux-product-search-visible"},
    {"action":"expectVisible","selector":"#scan-focus","name":"ux-scan-visible"},
    {"action":"expectVisible","selector":"#seller-select","name":"ux-seller-visible"},
    {"action":"expectVisible","selector":"#customer-search","name":"ux-customer-search-visible"},
    {"action":"expectVisible","selector":"#clear-cart","name":"ux-clear-cart-visible"},
    {"action":"expectVisible","selector":"#discount-percent","name":"ux-discount-visible"},
    {"action":"expectVisible","selector":"[data-pay=\"cash\"]","name":"ux-cash-visible"},
    {"action":"expectVisible","selector":"[data-pay=\"card\"]","name":"ux-card-visible"},
    {"action":"expectVisible","selector":"[data-pay=\"pix\"]","name":"ux-pix-visible"},
    {"action":"expectVisible","selector":"[data-pay=\"tef\"]","name":"ux-tef-visible"},
    {"action":"expectVisible","selector":"#finalize-sale","name":"ux-finalize-visible"},
    {"action":"waitFor","selector":"#sale-observation","name":"ux-observation-visible","timeoutMs":10000},

    {"action":"fill","selector":"#customer-search","value":"QA Cliente Balcao","name":"ux-search-customer"},
    {"action":"waitFor","selector":"[data-customer-id]","name":"ux-customer-suggestion","timeoutMs":10000},
    {"action":"click","selector":"[data-customer-id]","name":"ux-select-customer"},
    {"action":"expectText","selector":".sale-context-grid","expected":"QA Cliente Balcao","name":"ux-customer-selected"},

    {"action":"click","selector":".product-card[data-add-product]:has-text('QA UX Balcao')","name":"ux-add-product-discount"},
    {"action":"waitFor","selector":".cart-line","name":"ux-cart-ready","timeoutMs":10000},
    {"action":"fill","selector":"#discount-percent","value":"10","name":"ux-discount-10"},
    {"action":"press","selector":"#discount-percent","key":"Tab","name":"ux-apply-discount"},
    {"action":"expectText","selector":".totals","expected":"90,00","name":"ux-discount-total"},

    {"action":"click","selector":"#clear-cart","name":"ux-clear-cart"},
    {"action":"expectText","selector":".cart-list","expected":"Nenhum item","name":"ux-cart-cleared"},

    {"action":"click","selector":".product-card[data-add-product]:has-text('QA UX Balcao')","name":"ux-add-product-suspend"},
    {"action":"waitFor","selector":".cart-line","name":"ux-cart-before-suspend","timeoutMs":10000},
    {"action":"click","selector":"#suspend-sale","name":"ux-suspend-sale"},
    {"action":"waitFor","selector":"[data-resume]","name":"ux-resume-ready","timeoutMs":10000},
    {"action":"click","selector":"[data-resume]","name":"ux-resume-sale"},
    {"action":"expectText","selector":".cart-line","expected":"QA UX Balcao","name":"ux-sale-resumed"},

    {"action":"click","selector":"#cancel-sale","name":"ux-cancel-sale"},
    {"action":"waitFor","selector":"#confirm-cancel","name":"ux-cancel-modal-ready","timeoutMs":10000},
    {"action":"fill","selector":"#cancel-reason","value":"QA cancelamento UX","name":"ux-cancel-reason"},
    {"action":"click","selector":"#confirm-cancel","name":"ux-confirm-cancel"},
    {"action":"waitFor","selector":".checkout-layout[data-ux-checkout-preserved='true']","name":"ux-checkout-after-cancel","timeoutMs":10000},
    {"action":"expectText","selector":".cart-list","expected":"Nenhum item","name":"ux-cancelled-cart-empty"},

    {"action":"click","selector":".product-card[data-add-product]:has-text('QA UX Balcao')","name":"ux-add-product-payment"},
    {"action":"waitFor","selector":".cart-line","name":"ux-cart-before-payment","timeoutMs":10000},
    {"action":"screenshot","name":"checkout-ux-layout"},

    {"action":"click","selector":"[data-pay=\"cash\"]","name":"ux-quick-cash"},
    {"action":"waitFor","selector":"#initial-cash","name":"ux-cash-open-required","timeoutMs":10000},
    {"action":"fill","selector":"#initial-cash","value":"0,00","name":"ux-cash-initial"},
    {"action":"click","selector":"#confirm-open-cash","name":"ux-open-cash"},
    {"action":"waitFor","selector":"#confirm-payment","name":"ux-cash-payment-ready","timeoutMs":10000},
    {"action":"expectText","selector":".payment-list","expected":"Dinheiro","name":"ux-cash-payment-method"},
    {"action":"click","selector":"#modal-root .modal-head [data-close-modal]","name":"ux-close-cash-payment"},

    {"action":"click","selector":"[data-pay=\"pix\"]","name":"ux-quick-pix"},
    {"action":"waitFor","selector":"#confirm-payment","name":"ux-pix-payment-ready","timeoutMs":10000},
    {"action":"expectText","selector":".payment-list","expected":"PIX","name":"ux-pix-payment-method"},
    {"action":"click","selector":"#modal-root .modal-head [data-close-modal]","name":"ux-close-pix-payment"},

    {"action":"click","selector":"[data-pay=\"card\"]","name":"ux-quick-card"},
    {"action":"waitFor","selector":"#confirm-payment","name":"ux-card-payment-ready","timeoutMs":10000},
    {"action":"expectText","selector":".payment-list","expected":"Cartão crédito / TEF","name":"ux-card-payment-method"},
    {"action":"click","selector":"#modal-root .modal-head [data-close-modal]","name":"ux-close-card-payment"},

    {"action":"click","selector":"[data-pay=\"tef\"]","name":"ux-quick-tef"},
    {"action":"waitFor","selector":"#confirm-payment","name":"ux-tef-payment-ready","timeoutMs":10000},
    {"action":"expectText","selector":".payment-list","expected":"Cartão crédito / TEF","name":"ux-tef-payment-method"},
    {"action":"click","selector":"#modal-root .modal-head [data-close-modal]","name":"ux-close-tef-payment"},

    {"action":"click","selector":"#finalize-sale","name":"ux-open-multi-payment"},
    {"action":"waitFor","selector":"#confirm-payment","name":"ux-multi-payment-ready","timeoutMs":10000},
    {"action":"click","selector":"[data-remove-payment=\"0\"]","name":"ux-remove-default-payment"},
    {"action":"selectOption","selector":"#new-payment-method","value":"CASH","name":"ux-multi-cash-method"},
    {"action":"fill","selector":"#new-payment-value","value":"50,00","name":"ux-multi-cash-value"},
    {"action":"click","selector":"#add-payment","name":"ux-add-cash-payment"},
    {"action":"selectOption","selector":"#new-payment-method","value":"PIX","name":"ux-multi-pix-method"},
    {"action":"fill","selector":"#new-payment-value","value":"50,00","name":"ux-multi-pix-value"},
    {"action":"click","selector":"#add-payment","name":"ux-add-pix-payment"},
    {"action":"expectText","selector":".payment-list","expected":"Dinheiro","name":"ux-multi-has-cash"},
    {"action":"expectText","selector":".payment-list","expected":"PIX","name":"ux-multi-has-pix"},
    {"action":"screenshot","name":"checkout-ux-final","fullPage":true},
    {"action":"click","selector":"#confirm-payment","name":"ux-confirm-multi-payment"},
    {"action":"waitForTimeout","timeoutMs":800,"name":"ux-sale-completed"},
    {"action":"expectText","selector":".cart-list","expected":"Nenhum item","name":"ux-final-cart-empty"}
  ]
}
