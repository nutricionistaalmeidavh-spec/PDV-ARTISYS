{
  "name": "restaurant-module-sync-e2e",
  "steps": [
    {
      "action": "waitFor",
      "selector": "#setup-form",
      "name": "setup-ready",
      "timeoutMs": 15000
    },
    {
      "action": "fill",
      "selector": "#setup-form input[name='name']",
      "value": "QA Module Sync",
      "name": "setup-admin-name"
    },
    {
      "action": "fill",
      "selector": "#setup-form input[name='username']",
      "value": "qamodulesync",
      "name": "setup-admin-username"
    },
    {
      "action": "fill",
      "selector": "#setup-form input[name='password']",
      "value": "QaModuleSync-12345!",
      "name": "setup-admin-password"
    },
    {
      "action": "click",
      "selector": "#setup-form button[type='submit']",
      "name": "qa-admin-setup"
    },
    {
      "action": "waitFor",
      "selector": "#login-form",
      "name": "login-ready",
      "timeoutMs": 10000
    },
    {
      "action": "fill",
      "selector": "#login-form input[name='username']",
      "value": "qamodulesync",
      "name": "login-username"
    },
    {
      "action": "fill",
      "selector": "#login-form input[name='password']",
      "value": "QaModuleSync-12345!",
      "name": "login-password"
    },
    {
      "action": "click",
      "selector": "#login-form button[type='submit']",
      "name": "qa-login"
    },
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "state": "hidden",
      "name": "authenticated",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "#route-content [data-restaurant-route]",
      "name": "restaurant-launcher-visible",
      "timeoutMs": 10000
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/settings/modules.RESTAURANT.enabled",
      "method": "PUT",
      "body": {
        "value": false,
        "scope": "global"
      },
      "expectedStatus": 200,
      "name": "disable-restaurant-outside-api-client"
    },
    {
      "action": "waitFor",
      "selector": "#route-content [data-restaurant-route]",
      "state": "hidden",
      "name": "restaurant-launcher-hidden-after-external-change",
      "timeoutMs": 12000
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/settings/modules.RESTAURANT.enabled",
      "method": "PUT",
      "body": {
        "value": true,
        "scope": "global"
      },
      "expectedStatus": 200,
      "name": "enable-restaurant-outside-api-client"
    },
    {
      "action": "waitFor",
      "selector": "#route-content [data-restaurant-route]",
      "state": "visible",
      "name": "restaurant-launcher-restored-after-external-change",
      "timeoutMs": 12000
    }
  ]
}
