{
  "name": "restaurant-module-sync-e2e",
  "metadata": {
    "category": "state-sync",
    "critical": true,
    "tags": ["full", "release", "crosscut"]
  },
  "steps": [
    {"uses":"home.json"},
    {
      "action": "waitFor",
      "selector": "#route-content [data-restaurant-route]",
      "state": "visible",
      "name": "restaurant-launcher-visible",
      "timeoutMs": 10000
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/settings/modules.RESTAURANT.enabled",
      "method": "PUT",
      "body": {
        "value": false,
        "scope": "global"
      },
      "expectedStatus": 200,
      "name": "disable-restaurant-outside-api-client"
    },
    {
      "action": "waitFor",
      "selector": "#route-content [data-restaurant-route]",
      "state": "hidden",
      "name": "restaurant-launcher-hidden-after-external-change",
      "timeoutMs": 12000
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/restaurant/tables",
      "method": "GET",
      "expectedStatus": 409,
      "expectOk": false,
      "name": "restaurant-protected-probe-rejected-while-disabled"
    },
    {
      "action": "expectVisible",
      "selector": "#home-hub",
      "name": "home-stays-active-after-disabled-probe"
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/settings/modules.RESTAURANT.enabled",
      "method": "PUT",
      "body": {
        "value": true,
        "scope": "global"
      },
      "expectedStatus": 200,
      "name": "enable-restaurant-outside-api-client"
    },
    {
      "action": "waitFor",
      "selector": "#route-content [data-restaurant-route]",
      "state": "visible",
      "name": "restaurant-launcher-restored-after-external-change",
      "timeoutMs": 12000
    },
    {
      "action": "click",
      "selector": "#route-content [data-restaurant-route]",
      "name": "restaurant-navigation-restored"
    },
    {
      "action": "waitFor",
      "selector": ".restaurant-page",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "expectVisible",
      "selector": ".restaurant-page"
    },
    {
      "action": "screenshot",
      "name": "restaurant-module-sync-restored",
      "fullPage": true
    }
  ]
}
