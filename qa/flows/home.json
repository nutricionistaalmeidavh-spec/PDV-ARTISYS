{
  "name": "home",
  "steps": [
    {"action":"waitFor","selector":"#setup-form","name":"setup-ready","timeoutMs":15000},
    {"action":"fill","selector":"#setup-form input[name='name']","value":"QA Home","name":"setup-admin-name"},
    {"action":"fill","selector":"#setup-form input[name='username']","value":"qahome","name":"setup-admin-username"},
    {"action":"fill","selector":"#setup-form input[name='password']","value":"QaHomeLocal-12345!","name":"setup-admin-password"},
    {"action":"click","selector":"#setup-form button[type='submit']","name":"qa-admin-setup"},
    {"action":"waitFor","selector":"#login-form","name":"login-ready","timeoutMs":10000},
    {"action":"fill","selector":"#login-form input[name='username']","value":"qahome","name":"login-username"},
    {"action":"fill","selector":"#login-form input[name='password']","value":"QaHomeLocal-12345!","name":"login-password"},
    {"action":"click","selector":"#login-form button[type='submit']","name":"qa-login"},
    {"action":"waitFor","selector":"#auth-overlay","state":"hidden","name":"authenticated","timeoutMs":10000},
    {"action":"waitFor","selector":"#app-topbar","name":"app-ready","timeoutMs":15000},
    {"action":"waitFor","selector":"#sidebar-nav [data-route='home']","name":"home-nav-ready","timeoutMs":10000},
    {"action":"click","selector":"#sidebar-nav [data-route='home']","name":"open-home"},
    {"action":"waitFor","selector":"#route-content","name":"home-content"},
    {"action":"waitFor","selector":"#route-content [data-restaurant-route]","name":"restaurant-home-launcher-ready","timeoutMs":10000},
    {"action":"expectVisible","selector":"#route-content [data-restaurant-route]","name":"restaurant-home-launcher-visible"},
    {"action":"expectVisible","selector":"#network-status","name":"network-status-visible"},
    {"action":"expectText","selector":"#store-name","expected":"Loja","name":"store-context"},
    {"action":"waitFor","selector":"#home-hub","name":"operational-home-ready","timeoutMs":10000},
    {"action":"click","selector":".brand-mark","name":"open-classic-home"},
    {"action":"waitFor","selector":"#classic-home-grid","name":"classic-home-ready","timeoutMs":10000},
    {"action":"expectVisible","selector":"#classic-home-grid [data-classic-route='checkout']","name":"classic-checkout-visible"},
    {"action":"expectVisible","selector":"#classic-home-grid [data-classic-route='products']","name":"classic-products-visible"},
    {"action":"expectVisible","selector":"#classic-home-grid [data-classic-route='sales']","name":"classic-sales-visible"},
    {"action":"expectVisible","selector":"#classic-home-grid [data-classic-route='returns']","name":"classic-returns-visible"},
    {"action":"click","selector":"#classic-home-grid [data-classic-route='checkout']","name":"classic-open-checkout"},
    {"action":"waitFor","selector":".checkout-layout","name":"checkout-from-classic-ready","timeoutMs":10000},
    {"action":"click","selector":".brand-mark","name":"classic-from-checkout"},
    {"action":"waitFor","selector":"#classic-home-grid","name":"classic-home-restored","timeoutMs":10000},
    {"action":"click","selector":"#sidebar-nav [data-route='home']","name":"return-operational-home"},
    {"action":"waitFor","selector":"#home-hub","name":"operational-home-restored","timeoutMs":10000},
    {"action":"screenshot","name":"home-ready"}
  ]
}
