{
  "name": "home",
  "steps": [
    {"action":"waitFor","selector":"#first-access-form","name":"first-access-ready","timeoutMs":15000},
    {"action":"fill","selector":"#first-access-form input[name='name']","value":"QA Home","name":"setup-admin-name"},
    {"action":"fill","selector":"#first-access-form input[name='username']","value":"qahome","name":"setup-admin-username"},
    {"action":"fill","selector":"#first-access-form input[name='password']","value":"QaHomeLocal-12345!","name":"setup-admin-password"},
    {"action":"fill","selector":"#first-access-form input[name='passwordConfirm']","value":"QaHomeLocal-12345!","name":"setup-admin-password-confirm"},
    {"action":"click","selector":"#first-access-form button[type='submit']","name":"qa-admin-setup-and-login"},
    {"action":"waitFor","selector":"#auth-overlay","state":"hidden","name":"authenticated","timeoutMs":10000},
    {"action":"waitFor","selector":"#app-topbar","name":"app-ready","timeoutMs":15000},
    {"action":"waitFor","selector":"#onboarding-form","name":"onboarding-present-without-changing-modules","timeoutMs":10000},
    {"action":"waitFor","selector":"#sidebar-nav [data-route='home']","name":"home-nav-ready","timeoutMs":10000},
    {"action":"click","selector":"#sidebar-nav [data-route='home']","name":"open-home"},
    {"action":"waitFor","selector":"#route-content","name":"home-content"},
    {"action":"expectVisible","selector":"#network-status","name":"network-status-visible"},
    {"action":"expectText","selector":"#store-name","expected":"Loja","name":"store-context"},
    {"action":"waitFor","selector":"#classic-home-grid[data-home-role='admin']","name":"canonical-admin-home-ready","timeoutMs":10000},
    {"action":"expectVisible","selector":"#classic-home-grid [data-home-key='team']","name":"admin-team-visible"},
    {"action":"expectVisible","selector":"#classic-home-grid [data-home-key='devices']","name":"admin-devices-visible"},
    {"action":"expectVisible","selector":"#classic-home-grid [data-home-key='fiscal']","name":"admin-fiscal-visible"},
    {"action":"expectVisible","selector":"#classic-home-grid [data-home-key='backup']","name":"admin-backup-visible"},
    {"action":"expectVisible","selector":"#classic-home-grid [data-home-key='modules']","name":"admin-modules-visible"},
    {"action":"expectVisible","selector":"#classic-home-grid [data-classic-route='checkout']","name":"classic-checkout-visible"},
    {"action":"expectVisible","selector":"#classic-home-grid [data-classic-route='products']","name":"classic-products-visible"},
    {"action":"expectVisible","selector":"#classic-home-grid [data-classic-route='sales']","name":"classic-sales-visible"},
    {"action":"expectVisible","selector":"#classic-home-grid [data-classic-route='returns']","name":"classic-returns-visible"},
    {"action":"click","selector":"#classic-home-grid [data-classic-route='checkout']","name":"classic-open-checkout"},
    {"action":"waitFor","selector":".checkout-layout","name":"checkout-from-classic-ready","timeoutMs":10000},
    {"action":"click","selector":".brand-mark","name":"home-from-checkout"},
    {"action":"waitFor","selector":"#classic-home-grid[data-home-role='admin']","name":"canonical-home-restored-from-brand","timeoutMs":10000},
    {"action":"click","selector":"#sidebar-nav [data-route='home']","name":"return-canonical-home"},
    {"action":"waitFor","selector":"#classic-home-grid[data-home-role='admin']","name":"canonical-home-restored-from-sidebar","timeoutMs":10000}
  ]
}
