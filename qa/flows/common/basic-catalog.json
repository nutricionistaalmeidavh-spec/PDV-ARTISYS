{
  "name": "common-basic-catalog",
  "steps": [
    {"action":"click","selector":"[data-home-route='sellers']","name":"open-sellers"},
    {"action":"waitFor","selector":"#new-seller","name":"sellers-ready"},
    {"action":"click","selector":"#new-seller","name":"new-seller"},
    {"action":"fill","selector":"#seller-form input[name='name']","value":"QA Vendedor","name":"seller-name"},
    {"action":"fill","selector":"#seller-form input[name='username']","value":"qavendedor","name":"seller-username"},
    {"action":"fill","selector":"#seller-form input[name='password']","value":"TEST_ONLY_PASSWORD","name":"seller-password"},
    {"action":"click","selector":"#seller-form button[type='submit']","name":"save-seller"},
    {"action":"expectText","selector":".data-row:has([data-edit-seller])","expected":"QA Vendedor","name":"seller-created"},
    {"action":"click","selector":"[data-route='products']","name":"open-products"},
    {"action":"waitFor","selector":"#new-category","name":"products-ready"},
    {"action":"click","selector":"#new-category","name":"new-category"},
    {"action":"fill","selector":"#category-form input[name='name']","value":"QA Categoria","name":"category-name"},
    {"action":"click","selector":"#category-form button[type='submit']","name":"save-category"},
    {"action":"click","selector":"#new-product","name":"new-product"},
    {"action":"fill","selector":"#product-form input[name='name']","value":"QA Produto","name":"product-name"},
    {"action":"fill","selector":"#product-form input[name='sku']","value":"QA-001","name":"product-sku"},
    {"action":"fill","selector":"#product-form input[name='barcode']","value":"7890000000001","name":"product-barcode"},
    {"action":"selectOption","selector":"#product-form select[name='categoryId']","value":"QA Categoria","name":"product-category"},
    {"action":"fill","selector":"#product-form input[name='salePrice']","value":"10,00","name":"product-price"},
    {"action":"fill","selector":"#product-form input[name='cost']","value":"5,00","name":"product-cost"},
    {"action":"fill","selector":"#product-form input[name='minimumStock']","value":"2","name":"product-min-stock"},
    {"action":"click","selector":"#product-form button[type='submit']","name":"save-product"},
    {"action":"expectText","selector":".data-row:has([data-edit-product])","expected":"QA Produto","name":"product-created"},
    {"action":"click","selector":"[data-route='customers']","name":"open-customers"},
    {"action":"waitFor","selector":"#new-customer","name":"customers-ready"},
    {"action":"click","selector":"#new-customer","name":"new-customer"},
    {"action":"fill","selector":"#customer-form input[name='name']","value":"QA Cliente","name":"customer-name"},
    {"action":"fill","selector":"#customer-form input[name='document']","value":"12345678900","name":"customer-document"},
    {"action":"fill","selector":"#customer-form input[name='phone']","value":"16999990000","name":"customer-phone"},
    {"action":"click","selector":"#customer-form button[type='submit']","name":"save-customer"},
    {"action":"expectText","selector":".data-row:has([data-edit-customer])","expected":"QA Cliente","name":"customer-created"},
    {"action":"click","selector":".sidebar-back[data-route=\"home\"]","name":"return-home"}
  ]
}