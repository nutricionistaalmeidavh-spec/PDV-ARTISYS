{
  "name":"common-basic-sale",
  "steps":[
    {"action":"click","selector":"[data-home-route='checkout']","name":"open-checkout"},
    {"action":"waitFor","selector":"#seller-select","name":"checkout-ready","timeoutMs":10000},
    {"action":"fill","selector":"#product-search","value":"QA Produto","name":"search-product"},
    {"action":"waitFor","selector":"[data-add-product]","name":"product-result"},
    {"action":"click","selector":"[data-add-product]","name":"add-product"},
    {"action":"waitFor","selector":".cart-line","name":"cart-ready"},
    {"action":"fill","selector":"#customer-search","value":"QA Cliente","name":"search-customer"},
    {"action":"waitFor","selector":"[data-customer-id]","name":"customer-result"},
    {"action":"click","selector":"[data-customer-id]","name":"select-customer"},
    {"action":"selectOption","selector":"#seller-select","labelValue":"QA Vendedor","name":"select-seller"},
    {"action":"fill","selector":"#discount-percent","value":"5","name":"discount-five-percent"},
    {"action":"press","selector":"#discount-percent","key":"Tab","name":"apply-discount"},
    {"action":"waitFor","selector":"#sale-observation","name":"observation-ready"},
    {"action":"fill","selector":"#sale-observation","value":"QA venda completa","name":"sale-observation"},
    {"action":"check","selector":"#sale-observation-print","name":"print-observation"},
    {"action":"click","selector":"#finalize-sale","name":"finalize-sale"},
    {"action":"waitFor","selector":"#confirm-payment","name":"payment-ready","timeoutMs":10000},
    {"action":"click","selector":"#confirm-payment","name":"confirm-payment"},
    {"action":"waitFor","selector":".toast.success","name":"sale-success","timeoutMs":10000},
    {"action":"click","selector":".sidebar-back[data-route=\"home\"]","name":"sale-home"},
    {"action":"click","selector":"[data-home-route='sales']","name":"open-sales"},
    {"action":"waitFor","selector":"[data-sale-details]","name":"sales-history-ready","timeoutMs":10000},
    {"action":"click","selector":"[data-sale-details]","name":"sale-details"},
    {"action":"waitFor","selector":"#ops-sale-detail .ops-card","name":"sale-details-ready","timeoutMs":10000},
    {"action":"expectText","selector":"#ops-sale-detail","expected":"QA venda completa","name":"observation-persisted"}
  ]
}