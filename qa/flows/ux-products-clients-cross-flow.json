{
  "name":"ux-products-clients-cross-flow",
  "steps":[
    {"uses":"home.json"},

    {"action":"click","selector":"[data-route='customers']","name":"ux-paired-open-customers"},
    {"action":"waitFor","selector":"#new-customer","name":"ux-paired-customers-ready","timeoutMs":10000},
    {"action":"click","selector":"#new-customer","name":"ux-paired-new-customer"},
    {"action":"fill","selector":"#customer-form input[name='name']","value":"QA UX Cliente Integrado","name":"ux-paired-customer-name"},
    {"action":"fill","selector":"#customer-form input[name='document']","value":"12345678909","name":"ux-paired-customer-document"},
    {"action":"fill","selector":"#customer-form input[name='phone']","value":"16999990000","name":"ux-paired-customer-phone"},
    {"action":"fill","selector":"#customer-form input[name='creditLimit']","value":"100,00","name":"ux-paired-customer-credit"},
    {"action":"click","selector":"#customer-form button[type='submit']","name":"ux-paired-save-customer"},
    {"action":"waitFor","selector":"[data-customers-master-panel]","name":"ux-paired-customer-master-detail-ready","timeoutMs":10000},
    {"action":"expectText","selector":".customers-master-list","expected":"QA UX Cliente Integrado","name":"ux-paired-customer-created"},

    {"action":"click","selector":"[data-route='products']","name":"ux-paired-open-products"},
    {"action":"waitFor","selector":"#new-product","name":"ux-paired-products-ready","timeoutMs":10000},
    {"action":"click","selector":"#new-product","name":"ux-paired-new-product"},
    {"action":"fill","selector":"#product-form input[name='name']","value":"QA UX Produto Integrado","name":"ux-paired-product-name"},
    {"action":"fill","selector":"#product-form input[name='sku']","value":"QA-UX-PAIR-001","name":"ux-paired-product-sku"},
    {"action":"fill","selector":"#product-form input[name='salePrice']","value":"20,00","name":"ux-paired-product-price"},
    {"action":"fill","selector":"#product-form input[name='cost']","value":"8,00","name":"ux-paired-product-cost"},
    {"action":"fill","selector":"#product-form input[name='minimumStock']","value":"1","name":"ux-paired-product-minimum"},
    {"action":"click","selector":"#product-form button[type='submit']","name":"ux-paired-save-product"},
    {"action":"expectText","selector":".data-card:not([data-kit-combo-admin])","expected":"QA UX Produto Integrado","name":"ux-paired-product-created"},

    {"action":"click","selector":"[data-route='inventory']","name":"ux-paired-open-inventory"},
    {"action":"waitFor","selector":"#ops-inventory-form","name":"ux-paired-inventory-ready","timeoutMs":10000},
    {"action":"selectOption","selector":"#ops-inventory-form select[name='productId']","value":{"label":"QA UX Produto Integrado"},"name":"ux-paired-stock-product"},
    {"action":"fill","selector":"#ops-inventory-form input[name='quantity']","value":"3","name":"ux-paired-stock-quantity"},
    {"action":"fill","selector":"#ops-inventory-form input[name='reason']","value":"Entrada QA UX pareada","name":"ux-paired-stock-reason"},
    {"action":"click","selector":"#ops-inventory-form button[type='submit']","name":"ux-paired-stock-entry"},
    {"action":"waitForTimeout","timeoutMs":500,"name":"ux-paired-stock-refresh"},
    {"action":"click","selector":"[data-route='inventory']","name":"ux-paired-reopen-inventory-before-sale"},
    {"action":"waitFor","selector":"#ops-inventory-body","name":"ux-paired-inventory-before-sale-ready","timeoutMs":10000},
    {"action":"expectText","selector":"#ops-inventory-body","expected":"QA UX Produto Integrado","name":"ux-paired-stock-product-visible"},
    {"action":"expectText","selector":"#ops-inventory-body","expected":"3 UN","name":"ux-paired-stock-before-sale"},

    {"action":"click","selector":"[data-route='checkout']","name":"ux-paired-open-checkout"},
    {"action":"waitFor","selector":".checkout-layout","name":"ux-paired-checkout-ready","timeoutMs":10000},
    {"action":"fill","selector":"#customer-search","value":"QA UX Cliente Integrado","name":"ux-paired-customer-search"},
    {"action":"waitFor","selector":"#customer-suggestions [data-customer-id]","name":"ux-paired-customer-suggestion","timeoutMs":10000},
    {"action":"click","selector":"#customer-suggestions [data-customer-id]","name":"ux-paired-select-customer"},
    {"action":"expectText","selector":".customer-selected","expected":"QA UX Cliente Integrado","name":"ux-paired-customer-selected"},
    {"action":"click","selector":".product-card:has-text('QA UX Produto Integrado')","name":"ux-paired-add-product"},
    {"action":"waitFor","selector":".cart-line","name":"ux-paired-cart-ready","timeoutMs":10000},
    {"action":"expectText","selector":".cart-line","expected":"QA UX Produto Integrado","name":"ux-paired-cart-product"},
    {"action":"click","selector":"#finalize-sale","name":"ux-paired-finalize-sale"},
    {"action":"waitFor","selector":"#initial-cash","name":"ux-paired-cash-open-required","timeoutMs":10000},
    {"action":"fill","selector":"#initial-cash","value":"0,00","name":"ux-paired-cash-initial"},
    {"action":"click","selector":"#confirm-open-cash","name":"ux-paired-open-cash"},
    {"action":"waitFor","selector":"#confirm-payment","name":"ux-paired-payment-ready","timeoutMs":10000},
    {"action":"click","selector":"#confirm-payment","name":"ux-paired-confirm-payment"},
    {"action":"waitForTimeout","timeoutMs":800,"name":"ux-paired-sale-completed"},

    {"action":"click","selector":"[data-route='customers']","name":"ux-paired-return-customers"},
    {"action":"waitFor","selector":"#customer-page-search","name":"ux-paired-customer-search-page-ready","timeoutMs":10000},
    {"action":"fill","selector":"#customer-page-search","value":"QA UX Cliente Integrado","name":"ux-paired-filter-customer-page"},
    {"action":"waitFor","selector":"[data-customers-master-panel]","name":"ux-paired-history-panel-ready","timeoutMs":10000},
    {"action":"expectText","selector":"[data-customers-master-panel]","expected":"QA UX Cliente Integrado","name":"ux-paired-detail-selected-customer"},
    {"action":"click","selector":"[data-customers-master-panel] [data-action='customer-history']","name":"ux-paired-open-customer-history"},
    {"action":"waitFor","selector":"[data-customer-history-panel]","name":"ux-paired-customer-history-ready","timeoutMs":10000},
    {"action":"expectText","selector":"[data-customer-history-panel]","expected":"1 venda vinculada","name":"ux-paired-customer-sale-linked"},

    {"action":"click","selector":"[data-route='inventory']","name":"ux-paired-open-inventory-after-sale"},
    {"action":"waitFor","selector":"#ops-inventory-body","name":"ux-paired-inventory-after-sale-ready","timeoutMs":10000},
    {"action":"expectText","selector":"#ops-inventory-body","expected":"QA UX Produto Integrado","name":"ux-paired-stock-after-sale-product"},
    {"action":"expectText","selector":"#ops-inventory-body","expected":"2 UN","name":"ux-paired-stock-after-sale"},

    {"action":"click","selector":"[data-route='reports']","name":"ux-paired-open-reports"},
    {"action":"waitFor","selector":".report-v2-page","name":"ux-paired-reports-ready","timeoutMs":10000},
    {"action":"waitFor","selector":"#report-v2-filter","name":"ux-paired-report-filter-ready","timeoutMs":10000},
    {"action":"fill","selector":"#report-v2-filter input[name='fromDate']","value":"2020-01-01","name":"ux-paired-report-from"},
    {"action":"fill","selector":"#report-v2-filter input[name='toDate']","value":"2099-12-31","name":"ux-paired-report-to"},
    {"action":"click","selector":"#report-v2-filter button[type='submit']","name":"ux-paired-apply-report-period"},
    {"action":"waitForTimeout","timeoutMs":500,"name":"ux-paired-report-refresh"},
    {"action":"click","selector":"[data-report-view='customers']","name":"ux-paired-report-customers"},
    {"action":"expectText","selector":".report-v2-page","expected":"QA UX Cliente Integrado","name":"ux-paired-report-customer-linked"},
    {"action":"click","selector":"[data-report-view='products']","name":"ux-paired-report-products"},
    {"action":"expectText","selector":".report-v2-page","expected":"QA UX Produto Integrado","name":"ux-paired-report-product-linked"},
    {"action":"screenshot","name":"ux-products-clients-cross-flow","fullPage":true}
  ]
}
