{
  "name": "smoke",
  "steps": [
    {"action": "waitFor", "selector": "#app-topbar", "name": "topbar-ready", "timeoutMs": 15000},
    {"action": "expectVisible", "selector": ".topbar-brand", "name": "brand-visible"},
    {"action": "expectText", "selector": ".topbar-brand", "expected": "ARTISYS", "name": "brand-text"},
    {"action": "waitFor", "selector": "#auth-overlay", "name": "bootstrap", "timeoutMs": 15000},
    {"action": "fill", "selector": "#auth-overlay input[type='password']", "name": "senha-qa", "valueFromEnv": "ARTISYS_QA_PASSWORD"},
    {"action": "click", "text": "Criar administrador", "name": "criar-admin-qa", "exact": true},
    {"action": "fill", "selector": "#auth-overlay input:not([type='password'])", "name": "usuario-admin", "value": "admin"},
    {"action": "fill", "selector": "#auth-overlay input[type='password']", "name": "senha-login", "valueFromEnv": "ARTISYS_QA_PASSWORD"},
    {"action": "click", "text": "Entrar", "name": "entrar", "exact": true},
    {"action": "waitFor", "selector": "#auth-overlay", "name": "autenticado", "state": "hidden", "timeoutMs": 15000},
    {"action": "click", "selector": "[data-route='checkout']", "name": "open-balcao"},
    {"action": "waitFor", "selector": ".checkout-hero", "name": "balcao-ready", "timeoutMs": 15000},
    {"action": "expectText", "selector": ".checkout-hero", "expected": "Balcão", "name": "balcao-title"},
    {"action": "screenshot", "name": "balcao-current-screen"}
  ]
}
