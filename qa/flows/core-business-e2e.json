{
  "name": "core-business-e2e",
  "steps": [
    {"uses":"reports-complete.json"},

    {"action":"click","selector":"[data-route='products']","name":"core-open-products"},
    {"action":"waitFor","selector":"#new-product","name":"core-products-ready","timeoutMs":10000},
    {"action":"click","selector":"#new-product","name":"core-new-product"},
    {"action":"fill","selector":"#product-form input[name='name']","value":"QA Core Stock","name":"core-product-name"},
    {"action":"fill","selector":"#product-form input[name='sku']","value":"QA-CORE-STOCK","name":"core-product-sku"},
    {"action":"fill","selector":"#product-form input[name='salePrice']","value":"20,00","name":"core-product-price"},
    {"action":"fill","selector":"#product-form input[name='cost']","value":"8,00","name":"core-product-cost"},
    {"action":"fill","selector":"#product-form input[name='minimumStock']","value":"2","name":"core-product-minimum"},
    {"action":"click","selector":"#product-form button[type='submit']","name":"core-save-product"},
    {"action":"expectText","selector":".data-card:not([data-kit-combo-admin])","expected":"QA Core Stock","name":"core-product-created"},

    {"action":"click","selector":"[data-route='inventory']","name":"core-open-inventory"},
    {"action":"waitFor","selector":"#ops-inventory-form","name":"core-inventory-ready","timeoutMs":10000},
    {"action":"selectOption","selector":"#ops-inventory-form select[name='productId']","value":{"label":"QA Core Stock"},"name":"core-stock-product"},
    {"action":"fill","selector":"#ops-inventory-form input[name='quantity']","value":"5","name":"core-stock-quantity"},
    {"action":"fill","selector":"#ops-inventory-form input[name='reason']","value":"Entrada E2E núcleo","name":"core-stock-reason"},
    {"action":"click","selector":"#ops-inventory-form button[type='submit']","name":"core-stock-entry"},
    {"action":"waitForTimeout","timeoutMs":500,"name":"core-stock-entry-refresh"},
    {"action":"click","selector":"[data-route='inventory']","name":"core-reopen-inventory"},
    {"action":"waitFor","selector":"#ops-inventory-body","name":"core-inventory-restored","timeoutMs":10000},
    {"action":"expectText","selector":"#ops-inventory-body","expected":"QA Core Stock","name":"core-stock-product-visible"},
    {"action":"expectText","selector":"#ops-inventory-body","expected":"5 UN","name":"core-stock-before-sale"},

    {"action":"click","selector":"[data-route='checkout']","name":"core-open-checkout"},
    {"action":"waitFor","selector":".checkout-layout","name":"core-checkout-ready","timeoutMs":10000},
    {"action":"click","selector":".product-card:has-text('QA Core Stock') [data-add-product]","name":"core-add-product"},
    {"action":"waitFor","selector":".cart-line","name":"core-cart-ready","timeoutMs":10000},
    {"action":"expectText","selector":".cart-line","expected":"QA Core Stock","name":"core-cart-product"},
    {"action":"click","selector":"#finalize-sale","name":"core-finalize-sale"},
    {"action":"waitFor","selector":"#confirm-payment","name":"core-payment-ready","timeoutMs":10000},
    {"action":"click","selector":"#confirm-payment","name":"core-confirm-payment"},
    {"action":"waitForTimeout","timeoutMs":800,"name":"core-sale-completed"},

    {"action":"click","selector":"[data-route='inventory']","name":"core-open-inventory-after-sale"},
    {"action":"waitFor","selector":"#ops-inventory-body","name":"core-inventory-after-sale-ready","timeoutMs":10000},
    {"action":"expectText","selector":"#ops-inventory-body","expected":"QA Core Stock","name":"core-stock-product-after-sale"},
    {"action":"expectText","selector":"#ops-inventory-body","expected":"4 UN","name":"core-stock-decremented"},

    {"action":"click","selector":"[data-route='finance']","name":"core-open-finance"},
    {"action":"waitFor","selector":"#ops-finance-form","name":"core-finance-ready","timeoutMs":10000},
    {"action":"selectOption","selector":"#ops-finance-form select[name='kind']","value":"RECEIVABLE","name":"core-finance-kind"},
    {"action":"fill","selector":"#ops-finance-form input[name='description']","value":"QA Core Finance","name":"core-finance-description"},
    {"action":"fill","selector":"#ops-finance-form input[name='category']","value":"E2E","name":"core-finance-category"},
    {"action":"fill","selector":"#ops-finance-form input[name='amount']","value":"12,00","name":"core-finance-amount"},
    {"action":"fill","selector":"#ops-finance-form input[name='dueAt']","value":"2099-12-31","name":"core-finance-due"},
    {"action":"click","selector":"#ops-finance-form button[type='submit']","name":"core-save-finance"},
    {"action":"waitForTimeout","timeoutMs":500,"name":"core-finance-refresh"},
    {"action":"click","selector":"[data-route='finance']","name":"core-reopen-finance"},
    {"action":"waitFor","selector":".ops-page","name":"core-finance-restored","timeoutMs":10000},
    {"action":"expectText","selector":".ops-page","expected":"QA Core Finance","name":"core-finance-entry-visible"},

    {"action":"click","selector":"[data-route='reports']","name":"core-open-reports"},
    {"action":"waitFor","selector":"#ops-report-filter","name":"core-reports-ready","timeoutMs":10000},
    {"action":"fill","selector":"#ops-report-filter input[name='fromDate']","value":"2020-01-01","name":"core-report-from"},
    {"action":"fill","selector":"#ops-report-filter input[name='toDate']","value":"2099-12-31","name":"core-report-to"},
    {"action":"click","selector":"#ops-report-filter button[type='submit']","name":"core-apply-report-filter"},
    {"action":"waitForTimeout","timeoutMs":500,"name":"core-report-refresh"},
    {"action":"expectText","selector":".reports-page","expected":"QA Core Stock","name":"core-report-product"},
    {"action":"expectText","selector":".reports-page","expected":"Estoque e reposição","name":"core-report-inventory"},
    {"action":"expectText","selector":".reports-page","expected":"Financeiro","name":"core-report-finance"},
    {"action":"expectText","selector":".reports-page","expected":"Dinheiro","name":"core-report-cash-payment"},
    {"action":"screenshot","name":"phase4-core-business-e2e","fullPage":true}
  ]
}
