    {"action":"click","selector":"[data-module-toggle='SERVICES']","name":"parity-enable-services"},
    {"action":"waitFor","selector":"[data-module-open='SERVICES']","name":"parity-services-open-ready","timeoutMs":10000},
    {"action":"click","selector":"[data-module-open='SERVICES']","name":"parity-open-services"},
    {"action":"waitFor","selector":"#backend-services-lifecycle","name":"parity-services-lifecycle","timeoutMs":10000},
    {"action":"expectText","selector":"#backend-services-lifecycle","expected":"Ciclo do atendimento","name":"parity-services-title"},

    {"action":"click","selector":"[data-route='settings']","name":"parity-open-settings-workshop"},
    {"action":"waitFor","selector":"#ops-load-establishment-modules","name":"parity-modules-loader-2","timeoutMs":10000},
    {"action":"click","selector":"#ops-load-establishment-modules","name":"parity-load-modules-2"},
    {"action":"waitFor","selector":"[data-module-toggle='WORKSHOP']","name":"parity-workshop-toggle","timeoutMs":10000},
    {"action":"click","selector":"[data-module-toggle='WORKSHOP']","name":"parity-enable-workshop"},
    {"action":"waitFor","selector":"[data-module-open='WORKSHOP']","name":"parity-workshop-open-ready","timeoutMs":10000},
    {"action":"click","selector":"[data-module-open='WORKSHOP']","name":"parity-open-workshop"},
    {"action":"waitFor","selector":"#backend-workshop-lifecycle","name":"parity-workshop-lifecycle","timeoutMs":10000},
    {"action":"expectText","selector":"#backend-workshop-lifecycle","expected":"Operação completa da OS","name":"parity-workshop-title"},
    {"action":"screenshot","name":"backend-parity-p0","fullPage":true}
  ]
