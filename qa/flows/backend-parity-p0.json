    {"action":"expectText","selector":"#backend-parity-stock","expected":"Estoque por local","name":"parity-stock-local-title"},
    {"action":"waitFor","selector":"#enterprise-depth-entry","name":"parity-enterprise-entry","timeoutMs":10000},
    {"action":"click","selector":"#enterprise-depth-entry [data-open='logistics']","name":"parity-open-logistics"},
    {"action":"waitFor","selector":"#backend-terminal-stock","name":"parity-terminal-stock-ui","timeoutMs":10000},
    {"action":"expectText","selector":"#backend-terminal-stock","expected":"Estoque por terminal","name":"parity-terminal-stock-title"},

    {"action":"click","selector":"[data-route='finance']","name":"parity-open-finance"},
    {"action":"waitFor","selector":"#backend-finance-parity","name":"parity-finance-ui","timeoutMs":10000},
    {"action":"expectText","selector":"#backend-finance-parity","expected":"Contas financeiras","name":"parity-finance-accounts"},
    {"action":"expectText","selector":"#backend-finance-parity","expected":"Estornar baixas","name":"parity-finance-reversal"},

    {"action":"click","selector":"[data-route='returns']","name":"parity-open-returns"},
    {"action":"waitFor","selector":"#backend-return-cancel","name":"parity-return-ui","timeoutMs":10000},
    {"action":"expectText","selector":"#backend-return-cancel","expected":"Gerenciar devoluções","name":"parity-return-cancel-title"},

    {"action":"click","selector":"[data-route='settings']","name":"parity-open-settings-services"},
    {"action":"waitFor","selector":"#ops-load-establishment-modules","name":"parity-modules-loader","timeoutMs":10000},
    {"action":"click","selector":"#ops-load-establishment-modules","name":"parity-load-modules"},
