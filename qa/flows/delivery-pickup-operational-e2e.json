{
  "name": "delivery-pickup-operational-e2e",
  "title": "ArtiSys PDV — Delivery, retirada, KDS, WhatsApp e Balcão",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "delivery-bootstrap",
      "timeoutMs": 15000
    },
    {
      "action": "authenticateLocalQa",
      "name": "delivery-entrar",
      "timeoutMs": 15000
    },
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "delivery-autenticado",
      "state": "hidden",
      "timeoutMs": 15000
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/settings/modules.FOOD.enabled",
      "method": "PUT",
      "expectedStatus": 200,
      "name": "delivery-ativar-alimentacao",
      "body": {
        "value": true,
        "scope": "global"
      }
    },
    {
      "action": "reload",
      "name": "delivery-recarregar-areas"
    },
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "delivery-sessao-restaurada",
      "state": "hidden",
      "timeoutMs": 15000
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/products",
      "method": "POST",
      "expectedStatus": 201,
      "name": "delivery-seed-produto",
      "body": {
        "id": "qa-delivery-product",
        "name": "Hambúrguer Delivery QA",
        "sku": "QA-DEL-01",
        "salePriceCents": 2400,
        "costCents": 1000,
        "trackStock": false,
        "menuEnabled": true,
        "active": true
      }
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/restaurant/kitchen/stations",
      "method": "POST",
      "expectedStatus": 201,
      "name": "delivery-seed-setor",
      "body": {
        "id": "qa-delivery-kitchen",
        "name": "Cozinha Delivery QA",
        "printEnabled": false
      }
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/restaurant/kitchen/routing",
      "method": "POST",
      "expectedStatus": 200,
      "name": "delivery-seed-rota",
      "body": {
        "productId": "qa-delivery-product",
        "mode": "PRODUCTION",
        "stationId": "qa-delivery-kitchen"
      }
    },
    {
      "action": "waitFor",
      "selector": "[data-route='FOOD']",
      "name": "delivery-nav-alimentacao-disponivel",
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "click",
      "selector": "[data-route='FOOD']",
      "name": "delivery-abrir-alimentacao",
      "timeoutMs": 10000
    },
    {
      "action": "waitFor",
      "selector": "[data-food-capability='DELIVERY']",
      "name": "delivery-card-disponivel",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "[data-food-capability='DELIVERY']",
      "name": "delivery-abrir-painel",
      "timeoutMs": 10000
    },
    {
      "action": "expectVisible",
      "selector": "[data-delivery-operations]",
      "name": "delivery-painel-operacional",
      "timeoutMs": 10000
    },
    {
      "action": "selectOption",
      "selector": "#delivery-form select[name='fulfillmentType']",
      "value": "PICKUP",
      "name": "retirada-selecionar"
    },
    {
      "action": "fill",
      "selector": "#delivery-form input[name='customerName']",
      "value": "Cliente Retirada QA",
      "name": "retirada-cliente"
    },
    {
      "action": "fill",
      "selector": "#delivery-form input[name='phone']",
      "value": "16999999999",
      "name": "retirada-telefone"
    },
    {
      "action": "selectOption",
      "selector": "#delivery-form select[name='productId']",
      "value": "qa-delivery-product",
      "name": "retirada-produto"
    },
    {
      "action": "fill",
      "selector": "#delivery-form input[name='quantity']",
      "value": "1",
      "name": "retirada-quantidade"
    },
    {
      "action": "click",
      "selector": "#delivery-form [data-delivery-add-item]",
      "name": "retirada-adicionar-item",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "#delivery-form .delivery-send-production",
      "name": "retirada-criar-pedido",
      "timeoutMs": 15000
    },
    {
      "action": "expectText",
      "selector": "[data-delivery-order]:has-text('Cliente Retirada QA')",
      "expected": "Aguardando produção",
      "name": "retirada-aguardando-producao",
      "timeoutMs": 15000
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/vertical/delivery?fulfillmentType=PICKUP",
      "method": "GET",
      "expectedStatus": 200,
      "name": "retirada-localizar-api",
      "saveAs": {
        "qaPickupId": "0.id"
      }
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/restaurant/kitchen/tickets?stationId=qa-delivery-kitchen&limit=20",
      "method": "GET",
      "expectedStatus": 200,
      "name": "retirada-localizar-ticket",
      "saveAs": {
        "qaPickupTicketId": "0.id"
      }
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/restaurant/kitchen/tickets/{{qaPickupTicketId}}",
      "method": "PATCH",
      "expectedStatus": 200,
      "name": "retirada-kds-iniciar-preparo",
      "body": {
        "status": "PREPARING"
      }
    },
    {
      "action": "expectText",
      "selector": "[data-delivery-order]:has-text('Cliente Retirada QA')",
      "expected": "Preparando",
      "name": "retirada-painel-preparando",
      "timeoutMs": 15000
    },
    {
      "action": "desktopApiRequest",
      "path": "/api/v1/restaurant/kitchen/tickets/{{qaPickupTicketId}}",
      "method": "PATCH",
      "expectedStatus": 200,
      "name": "retirada-kds-marcar-pronto",
      "body": {
        "status": "READY"
      }
    },
    {
      "action": "expectText",
      "selector": "[data-delivery-order]:has-text('Cliente Retirada QA')",
      "expected": "Pedido pronto",
      "name": "retirada-pedido-pronto",
      "timeoutMs": 15000
    },
    {
      "action": "expectVisible",
      "selector": "[data-delivery-order]:has-text('Cliente Retirada QA') [data-delivery-whatsapp]",
      "name": "retirada-whatsapp-disponivel",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "[data-delivery-order]:has-text('Cliente Retirada QA') [data-delivery-whatsapp]",
      "name": "retirada-whatsapp-abrir",
      "timeoutMs": 10000
    },
    {
      "action": "expectText",
      "selector": "[data-delivery-order]:has-text('Cliente Retirada QA') [data-delivery-whatsapp]",
      "expected": "WhatsApp aberto",
      "name": "retirada-whatsapp-confirmado",
      "timeoutMs": 10000
    },
    {
      "action": "screenshot",
      "name": "retirada-pronta-whatsapp",
      "fullPage": true
    },
    {
      "action": "selectOption",
      "selector": "#delivery-form select[name='fulfillmentType']",
      "value": "DELIVERY",
      "name": "delivery-selecionar"
    },
    {
      "action": "fill",
      "selector": "#delivery-form input[name='customerName']",
      "value": "Cliente Delivery QA",
      "name": "delivery-cliente"
    },
    {
      "action": "fill",
      "selector": "#delivery-form input[name='phone']",
      "value": "16888887777",
      "name": "delivery-telefone"
    },
    {
      "action": "fill",
      "selector": "#delivery-form input[name='region']",
      "value": "Centro",
      "name": "delivery-regiao"
    },
    {
      "action": "fill",
      "selector": "#delivery-form input[name='street']",
      "value": "Rua QA",
      "name": "delivery-rua"
    },
    {
      "action": "fill",
      "selector": "#delivery-form input[name='number']",
      "value": "123",
      "name": "delivery-numero"
    },
    {
      "action": "fill",
      "selector": "#delivery-form input[name='district']",
      "value": "Centro",
      "name": "delivery-bairro"
    },
    {
      "action": "fill",
      "selector": "#delivery-form input[name='city']",
      "value": "Cidade QA",
      "name": "delivery-cidade"
    },
    {
      "action": "fill",
      "selector": "#delivery-form input[name='state']",
      "value": "SP",
      "name": "delivery-uf"
    },
    {
      "action": "fill",
      "selector": "#delivery-form input[name='fee']",
      "value": "5,00",
      "name": "delivery-taxa"
    },
    {
      "action": "selectOption",
      "selector": "#delivery-form select[name='productId']",
      "value": "qa-delivery-product",
      "name": "delivery-produto"
    },
    {
      "action": "click",
      "selector": "#delivery-form [data-delivery-add-item]",
      "name": "delivery-adicionar-item",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "#delivery-form .delivery-send-production",
      "name": "delivery-criar-pedido",
      "timeoutMs": 15000
    },
    {
      "action": "expectText",
      "selector": "[data-delivery-order]:has-text('Cliente Delivery QA')",
      "expected": "Aguardando produção",
      "name": "delivery-aguardando-producao",
      "timeoutMs": 15000
    },
    {
      "action": "screenshot",
      "name": "delivery-painel-operacional",
      "fullPage": true
    },
    {
      "action": "expectNoHorizontalOverflow",
      "selector": "#route-content",
      "name": "delivery-sem-overflow",
      "tolerancePx": 4,
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "button[data-route='checkout']",
      "name": "delivery-ir-balcao",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "#checkout-documents",
      "name": "delivery-busca-balcao",
      "timeoutMs": 10000
    },
    {
      "action": "fill",
      "selector": "#checkout-document-query",
      "value": "Cliente Delivery QA",
      "name": "delivery-buscar-cliente",
      "timeoutMs": 10000
    },
    {
      "action": "press",
      "selector": "#checkout-document-query",
      "key": "Enter",
      "name": "delivery-buscar-confirmar",
      "timeoutMs": 10000
    },
    {
      "action": "expectVisible",
      "selector": ".data-row:has-text('Cliente Delivery QA') [data-open-checkout-document^='DELIVERY:']",
      "name": "delivery-resultado-balcao",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": ".data-row:has-text('Cliente Delivery QA') [data-open-checkout-document^='DELIVERY:']",
      "name": "delivery-abrir-no-caixa",
      "timeoutMs": 10000
    },
    {
      "action": "expectText",
      "selector": "[data-checkout-document-context]",
      "expected": "Cliente Delivery QA",
      "name": "delivery-contexto-caixa",
      "timeoutMs": 10000
    },
    {
      "action": "expectText",
      "selector": "[data-checkout-document-context]",
      "expected": "Delivery",
      "name": "delivery-canal-caixa",
      "timeoutMs": 10000
    },
    {
      "action": "expectVisible",
      "selector": "#finalize-sale",
      "name": "delivery-finalizacao-canonica-disponivel",
      "timeoutMs": 10000
    },
    {
      "action": "screenshot",
      "name": "delivery-aberto-no-balcao",
      "fullPage": true
    }
  ]
}
