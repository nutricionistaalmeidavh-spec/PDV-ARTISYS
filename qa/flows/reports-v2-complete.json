    {"action":"expectVisible","selector":"#report-export","name":"reports-v2-export"},
    {"action":"expectVisible","selector":"#report-print","name":"reports-v2-print"},
    {"action":"expectText","selector":".report-v2-page","expected":"Dinheiro","name":"reports-v2-cash-localized"},
    {"action":"click","selector":"[data-report-view='customers']","name":"reports-v2-customers-tab"},
