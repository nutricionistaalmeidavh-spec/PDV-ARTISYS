    {"action":"fill","selector":"#product-form input[name='sku']","value":"QA-REPORT-V2","name":"reports-product-sku"},
    {"action":"fill","selector":"#product-form input[name='salePrice']","value":"10,00","name":"reports-product-price"},
    {"action":"fill","selector":"#product-form input[name='cost']","value":"4,00","name":"reports-product-cost"},
    {"action":"uncheck","selector":"#product-form input[name='trackStock']","name":"reports-product-no-stock"},
    {"action":"click","selector":"#product-form button[type='submit']","name":"reports-save-product"},
    {"action":"expectText","selector":".data-card:not([data-kit-combo-admin])","expected":"QA Relatório V2","name":"reports-product-created"},
