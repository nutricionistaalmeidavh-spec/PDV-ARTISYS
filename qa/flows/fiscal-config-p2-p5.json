{
  "name":"fiscal-config-p2-p5",
  "steps":[
    {"uses":"core-business-e2e.json"},
    {"action":"click","selector":"[data-route='settings']","name":"p2-open-settings"},
    {"action":"waitFor","selector":"#fiscal-config-workspace","name":"p2-workspace-ready","timeoutMs":10000},
    {"action":"fill","selector":"#fiscal-company-form input[name='cnpj']","value":"123","name":"p2-invalid-cnpj"},
    {"action":"click","selector":"#fiscal-company-form button[type='submit']","name":"p2-reject-invalid-company"},
    {"action":"waitFor","selector":".toast.error","name":"p2-invalid-company-error","timeoutMs":5000},
    {"action":"expectText","selector":".toast.error","expected":"CNPJ","name":"p2-invalid-cnpj-message"},
    {"action":"fill","selector":"#fiscal-company-form input[name='cnpj']","value":"12345678000195","name":"p2-cnpj"},
    {"action":"fill","selector":"#fiscal-company-form input[name='stateRegistration']","value":"123456789","name":"p2-ie"},
    {"action":"fill","selector":"#fiscal-company-form input[name='legalName']","value":"QA Fiscal LTDA","name":"p2-legal-name"},
    {"action":"fill","selector":"#fiscal-company-form input[name='tradeName']","value":"QA Fiscal","name":"p2-trade-name"},
    {"action":"selectOption","selector":"#fiscal-company-form select[name='crt']","value":"1","name":"p2-crt"},
    {"action":"fill","selector":"#fiscal-company-form input[name='cnae']","value":"4711302","name":"p2-cnae"},
    {"action":"fill","selector":"#fiscal-company-form input[name='series']","value":"1","name":"p2-series"},
    {"action":"fill","selector":"#fiscal-company-form input[name='operationNature']","value":"VENDA","name":"p2-operation"},
    {"action":"fill","selector":"#fiscal-company-form input[name='cscId']","value":"1","name":"p2-csc-id"},
    {"action":"fill","selector":"#fiscal-company-form input[name='street']","value":"Rua QA","name":"p2-street"},
    {"action":"fill","selector":"#fiscal-company-form input[name='number']","value":"100","name":"p2-number"},
    {"action":"fill","selector":"#fiscal-company-form input[name='district']","value":"Centro","name":"p2-district"},
    {"action":"fill","selector":"#fiscal-company-form input[name='cityCode']","value":"3543402","name":"p2-city-code"},
    {"action":"fill","selector":"#fiscal-company-form input[name='city']","value":"Ribeirao Preto","name":"p2-city"},
    {"action":"fill","selector":"#fiscal-company-form input[name='state']","value":"SP","name":"p2-state"},
    {"action":"fill","selector":"#fiscal-company-form input[name='zip']","value":"14010000","name":"p2-zip"},
    {"action":"click","selector":"#fiscal-company-form button[type='submit']","name":"p2-save-company"},
    {"action":"waitFor","selector":"#fiscal-company-summary","name":"p2-company-persisted","timeoutMs":5000},
    {"action":"expectText","selector":"#fiscal-company-summary","expected":"QA Fiscal LTDA","name":"p2-company-summary"},
    {"action":"click","selector":"[data-route='home']","name":"p2-leave-settings"},
    {"action":"click","selector":"[data-route='settings']","name":"p2-reopen-settings"},
    {"action":"waitFor","selector":"#fiscal-company-summary","name":"p2-company-reloaded","timeoutMs":10000},
    {"action":"expectText","selector":"#fiscal-company-summary","expected":"12345678000195","name":"p2-company-data-reloaded"},

    {"action":"click","selector":"[data-tab='profiles']","name":"p3-open-profiles"},
    {"action":"fill","selector":"#fiscal-profile-form input[name='name']","value":"QA Revenda Fiscal","name":"p3-profile-name"},
    {"action":"fill","selector":"#fiscal-profile-form input[name='ncm']","value":"61091000","name":"p3-ncm"},
    {"action":"fill","selector":"#fiscal-profile-form input[name='cfop']","value":"5102","name":"p3-cfop"},
    {"action":"selectOption","selector":"#fiscal-profile-form select[name='origin']","value":"0","name":"p3-origin"},
    {"action":"fill","selector":"#fiscal-profile-form input[name='csosn']","value":"102","name":"p3-csosn"},
    {"action":"fill","selector":"#fiscal-profile-form input[name='pisCst']","value":"49","name":"p3-pis"},
    {"action":"fill","selector":"#fiscal-profile-form input[name='cofinsCst']","value":"49","name":"p3-cofins"},
    {"action":"fill","selector":"#fiscal-profile-form input[name='unit']","value":"UN","name":"p3-unit"},
    {"action":"fill","selector":"#fiscal-profile-form input[name='ibsCbsCst']","value":"000","name":"p3-ibs-cbs"},
    {"action":"fill","selector":"#fiscal-profile-form input[name='cClassTrib']","value":"000001","name":"p3-class-trib"},
    {"action":"click","selector":"#fiscal-profile-form button[type='submit']","name":"p3-save-profile"},
    {"action":"waitFor","selector":".fiscal-list-item:has-text('QA Revenda Fiscal')","name":"p3-profile-created","timeoutMs":5000},
    {"action":"click","selector":".fiscal-list-item:has-text('QA Revenda Fiscal')","name":"p3-edit-profile"},
    {"action":"fill","selector":"#fiscal-profile-form input[name='name']","value":"QA Revenda Fiscal Editado","name":"p3-edit-name"},
    {"action":"click","selector":"#fiscal-profile-form button[type='submit']","name":"p3-save-edit"},
    {"action":"waitFor","selector":".fiscal-list-item:has-text('QA Revenda Fiscal Editado')","name":"p3-profile-edited","timeoutMs":5000},
    {"action":"click","selector":".fiscal-list-item:has-text('QA Revenda Fiscal Editado')","name":"p3-open-for-duplicate"},
    {"action":"click","selector":"#fiscal-profile-duplicate","name":"p3-duplicate-profile"},
    {"action":"click","selector":"#fiscal-profile-form button[type='submit']","name":"p3-save-duplicate"},
    {"action":"waitFor","selector":".fiscal-list-item:has-text('(cópia)')","name":"p3-duplicate-created","timeoutMs":5000},
    {"action":"fill","selector":"#fiscal-profile-search","value":"cópia","name":"p3-search-profile"},
    {"action":"expectText","selector":"#fiscal-profile-list","expected":"(cópia)","name":"p3-search-result"},
    {"action":"click","selector":".fiscal-list-item:has-text('(cópia)')","name":"p3-open-copy"},
    {"action":"uncheck","selector":"#fiscal-profile-form input[name='active']","name":"p3-deactivate-copy"},
    {"action":"click","selector":"#fiscal-profile-form button[type='submit']","name":"p3-save-deactivation"},
    {"action":"waitFor","selector":".fiscal-list-item:has-text('(cópia)')","name":"p3-copy-reloaded","timeoutMs":5000},
    {"action":"expectText","selector":".fiscal-list-item:has-text('(cópia)')","expected":"INATIVO","name":"p3-copy-inactive"},

    {"action":"click","selector":"[data-route='products']","name":"p4-open-catalog"},
    {"action":"waitFor","selector":".data-row:has-text('QA Core Stock') [data-edit-product]","name":"p4-core-product-ready","timeoutMs":10000},
    {"action":"click","selector":".data-row:has-text('QA Core Stock') [data-edit-product]","name":"p4-edit-core-product"},
    {"action":"waitFor","selector":"#product-fiscal-fields","name":"p4-fiscal-fields-mounted","timeoutMs":5000},
    {"action":"selectOption","selector":"#product-fiscal-fields select[name='fiscalProfileId']","value":{"label":"QA Revenda Fiscal Editado · NCM 61091000"},"name":"p4-assign-profile"},
    {"action":"fill","selector":"#product-fiscal-fields input[name='fiscalGtin']","value":"7891234567895","name":"p4-gtin"},
    {"action":"click","selector":"#product-form button[type='submit']","name":"p4-save-product-with-fiscal"},
    {"action":"waitFor","selector":".toast.success:has-text('tributação fiscal')","name":"p4-fiscal-binding-saved","timeoutMs":5000},
    {"action":"click","selector":".data-row:has-text('QA Core Stock') [data-edit-product]","name":"p4-reopen-core-product"},
    {"action":"waitFor","selector":"#product-fiscal-current","name":"p4-fiscal-current-ready","timeoutMs":5000},
    {"action":"expectText","selector":"#product-fiscal-current","expected":"QA Revenda Fiscal Editado","name":"p4-profile-persisted"},
    {"action":"click","selector":"[data-close-modal]","name":"p4-close-product"},
    {"action":"click","selector":"#new-product","name":"p5-new-pending-product"},
    {"action":"fill","selector":"#product-form input[name='name']","value":"QA Fiscal Pending","name":"p5-pending-name"},
    {"action":"fill","selector":"#product-form input[name='sku']","value":"QA-FISC-PENDING","name":"p5-pending-sku"},
    {"action":"fill","selector":"#product-form input[name='salePrice']","value":"10,00","name":"p5-pending-price"},
    {"action":"click","selector":"#product-form button[type='submit']","name":"p5-save-pending-product"},
    {"action":"expectText","selector":".data-card","expected":"QA Fiscal Pending","name":"p5-pending-created"},

    {"action":"click","selector":"[data-route='settings']","name":"p5-open-settings"},
    {"action":"waitFor","selector":"#fiscal-config-workspace","name":"p5-workspace-ready","timeoutMs":10000},
    {"action":"click","selector":"[data-tab='audit']","name":"p5-open-audit"},
    {"action":"expectText","selector":"#fiscal-config-body","expected":"P5 · Pendências tributárias","name":"p5-audit-heading"},
    {"action":"click","selector":"[data-audit-filter='MISSING_PROFILE']","name":"p5-filter-missing-profile"},
    {"action":"expectText","selector":"#fiscal-audit-table","expected":"QA Fiscal Pending","name":"p5-pending-visible"},
    {"action":"click","selector":"tr:has-text('QA Fiscal Pending') [data-audit-configure]","name":"p5-configure-pending"},
    {"action":"selectOption","selector":"#fiscal-product-profile","value":{"label":"QA Revenda Fiscal Editado"},"name":"p5-select-profile"},
    {"action":"click","selector":"#fiscal-product-form button[type='submit']","name":"p5-save-correction"},
    {"action":"waitForTimeout","timeoutMs":400,"name":"p5-refresh-audit-state"},
    {"action":"click","selector":"[data-tab='audit']","name":"p5-reopen-audit"},
    {"action":"click","selector":"[data-audit-filter='ok']","name":"p5-filter-ok"},
    {"action":"expectText","selector":"#fiscal-audit-table","expected":"QA Fiscal Pending","name":"p5-correction-now-ok"},
    {"action":"screenshot","name":"fiscal-config-p2-p5","fullPage":true}
  ]
}