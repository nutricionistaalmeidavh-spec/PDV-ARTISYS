    {
      "action": "screenshot",
      "name": "05-cardapio-seletor-origem",
      "fullPage": false
    },
    {
      "action": "click",
      "selector": "button[data-add-menu-source='qa-coke']",
      "name": "adicionar-coca",
      "holdMs": 700
    },
    {
      "action": "waitFor",
      "selector": "#modal-root",
      "name": "modal-fechado-coca",
      "state": "hidden",
      "timeoutMs": 10000
    },
    {
      "action": "screenshot",
      "name": "06-cardapio-coca",
      "fullPage": true
    },
    {
      "action": "click",
      "selector": "#new-product",
      "name": "abrir-seletor-2"
    },
    {
      "action": "waitFor",
      "selector": "button[data-add-menu-source='qa-xtudo']",
      "name": "xtudo-disponivel",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "button[data-add-menu-source='qa-xtudo']",
