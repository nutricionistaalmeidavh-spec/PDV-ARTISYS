{
  "name": "product-design-menu-audit",
  "title": "Product Design — Estoque, Ficha Técnica e Cardápio",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "bootstrap",
      "timeoutMs": 15000
    },
    {
      "action": "authenticateLocalQa",
      "name": "autenticar-qa",
      "username": "qaadmin",
      "password": "QaLocalOnly-12345!"
    },
    {
      "action": "desktopApiRequest",
      "name": "seed-pao",
      "path": "/api/v1/products",
      "method": "POST",
      "body": {
        "id": "qa-bread",
        "name": "Pão brioche",
        "sku": "PAO-BR",
        "salePriceCents": 250,
        "costCents": 120,
        "trackStock": true,
        "minimumStock": 5,
        "active": true
      },
      "expectedStatus": 201
    },
    {
      "action": "desktopApiRequest",
      "name": "seed-carne",
      "path": "/api/v1/products",
      "method": "POST",
      "body": {
        "id": "qa-meat",
        "name": "Carne 180g",
        "sku": "CARNE-180",
        "unit": "KG",
        "salePriceCents": 900,
        "costCents": 650,
        "trackStock": true,
        "minimumStock": 3,
        "active": true
      },
      "expectedStatus": 201
    },
    {
      "action": "desktopApiRequest",
      "name": "seed-coca",
      "path": "/api/v1/products",
      "method": "POST",
      "body": {
        "id": "qa-coke",
        "name": "Coca-Cola 350ml",
        "sku": "COCA-350",
        "salePriceCents": 700,
        "costCents": 350,
        "trackStock": true,
        "minimumStock": 6,
        "active": true
      },
      "expectedStatus": 201
    },
    {
      "action": "desktopApiRequest",
      "name": "seed-xtudo",
      "path": "/api/v1/products",
      "method": "POST",
      "body": {
        "id": "qa-xtudo",
        "name": "X-Tudo",
        "sku": "XT-001",
        "salePriceCents": 2790,
        "costCents": 0,
        "trackStock": false,
        "minimumStock": 0,
        "active": true
      },
      "expectedStatus": 201
    },
    {
      "action": "desktopApiRequest",
      "name": "seed-ficha-xtudo",
      "path": "/api/v1/vertical/recipes/qa-xtudo",
      "method": "PUT",
      "body": {
        "components": [
          {
            "productId": "qa-bread",
            "quantity": 1,
            "unit": "UN"
          },
          {
            "productId": "qa-meat",
            "quantity": 0.18,
            "unit": "KG"
          }
        ]
      },
      "expectedStatus": 200
    },
    {
      "action": "desktopApiRequest",
      "name": "saldo-pao",
      "path": "/api/v1/inventory/movements",
      "method": "POST",
      "body": {
        "productId": "qa-bread",
        "type": "opening",
        "quantityDelta": 30,
        "reason": "QA Product Design"
      },
      "expectedStatus": 201
    },
    {
      "action": "desktopApiRequest",
      "name": "saldo-carne",
      "path": "/api/v1/inventory/movements",
      "method": "POST",
      "body": {
        "productId": "qa-meat",
        "type": "opening",
        "quantityDelta": 20,
        "reason": "QA Product Design"
      },
      "expectedStatus": 201
    },
    {
      "action": "desktopApiRequest",
      "name": "saldo-coca",
      "path": "/api/v1/inventory/movements",
      "method": "POST",
      "body": {
        "productId": "qa-coke",
        "type": "opening",
        "quantityDelta": 48,
        "reason": "QA Product Design"
      },
      "expectedStatus": 201
    },
    {
      "action": "click",
      "selector": "button[data-route='catalog']",
      "name": "abrir-hub-cardapio-estoque",
      "holdMs": 500
    },
    {
      "action": "screenshot",
      "name": "00-hub-cardapio-estoque",
      "fullPage": true
    },
    {
      "action": "click",
      "selector": "[data-flow-route='inventory']",
      "name": "abrir-estoque",
      "holdMs": 700
    },
    {
      "action": "waitFor",
      "selector": "#inventory-master-actions",
      "name": "estoque-pronto",
      "timeoutMs": 10000
    },
    {
      "action": "screenshot",
      "name": "01-estoque-cadastro-mestre",
      "fullPage": true
    },
    {
      "action": "click",
      "selector": "#inventory-new-product",
      "name": "novo-produto"
    },
    {
      "action": "waitFor",
      "selector": "#product-form",
      "name": "form-produto-pronto",
      "timeoutMs": 10000
    },
    {
      "action": "screenshot",
      "name": "02-estoque-novo-produto",
      "fullPage": false
    },
    {
      "action": "click",
      "selector": "#modal-root .modal-close",
      "name": "fechar-produto"
    },
    {
      "action": "waitForTimeout",
      "name": "esperar-fechamento-produto",
      "timeoutMs": 350
    },
    {
      "action": "screenshot",
      "name": "02b-estoque-apos-fechar-produto",
      "fullPage": false
    },
    {
      "action": "reload",
      "name": "recarregar-apos-produto"
    },
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "sessao-restaurada-1",
      "state": "hidden",
      "timeoutMs": 15000
    },
    {
      "action": "click",
      "selector": "button[data-route='catalog']",
      "name": "hub-para-ficha",
      "holdMs": 400
    },
    {
      "action": "click",
      "selector": "[data-flow-route='inventory']",
      "name": "estoque-para-ficha",
      "holdMs": 700
    },
    {
      "action": "click",
      "selector": "#inventory-new-recipe",
      "name": "nova-ficha"
    },
    {
      "action": "waitFor",
      "selector": "#recipe-product-form",
      "name": "form-ficha-pronto",
      "timeoutMs": 10000
    },
    {
      "action": "screenshot",
      "name": "03-estoque-nova-ficha",
      "fullPage": false
    },
    {
      "action": "click",
      "selector": "#modal-root .modal-close",
      "name": "fechar-ficha"
    },
    {
      "action": "waitForTimeout",
      "name": "esperar-fechamento-ficha",
      "timeoutMs": 350
    },
    {
      "action": "screenshot",
      "name": "03b-estoque-apos-fechar-ficha",
      "fullPage": false
    },
    {
      "action": "reload",
      "name": "recarregar-apos-ficha"
    },
    {
      "action": "waitFor",
      "selector": "#auth-overlay",
      "name": "sessao-restaurada-2",
      "state": "hidden",
      "timeoutMs": 15000
    },
    {
      "action": "click",
      "selector": "button[data-route='catalog']",
      "name": "hub-para-cardapio",
      "holdMs": 400
    },
    {
      "action": "click",
      "selector": "[data-flow-route='products']",
      "name": "abrir-cardapio",
      "holdMs": 900
    },
    {
      "action": "waitFor",
      "selector": "#new-product",
      "name": "cardapio-pronto",
      "timeoutMs": 10000
    },
    {
      "action": "screenshot",
      "name": "04-cardapio-vazio",
      "fullPage": true
    },
    {
      "action": "click",
      "selector": "#new-product",
      "name": "abrir-seletor"
    },
    {
      "action": "waitFor",
      "selector": "#menu-source-picker",
      "name": "seletor-pronto",
      "timeoutMs": 10000
