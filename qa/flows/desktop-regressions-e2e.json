{
  "name":"desktop-regressions-e2e",
  "steps":[
    {"uses":"home.json"},

    {"action":"click","selector":"[data-route='products']","name":"reg-open-products"},
    {"action":"waitFor","selector":"#new-product","name":"reg-products-ready","timeoutMs":10000},
    {"action":"click","selector":"#new-product","name":"reg-new-product"},
    {"action":"waitFor","selector":"#product-form","name":"reg-product-form-ready","timeoutMs":5000},
    {"action":"fill","selector":"#product-form input[name='name']","value":"QA REGRESSAO PRODUTO NOME MUITO LONGO PARA TESTAR CARRINHO RESPONSIVO","name":"reg-product-name"},
    {"action":"fill","selector":"#product-form input[name='sku']","value":"QA-REG-LONG","name":"reg-product-sku"},
    {"action":"fill","selector":"#product-form input[name='barcode']","value":"7899876543210","name":"reg-product-barcode"},
    {"action":"fill","selector":"#product-form input[name='salePrice']","value":"10,00","name":"reg-product-price"},
    {"action":"fill","selector":"#product-form input[name='cost']","value":"4,00","name":"reg-product-cost"},
    {"action":"uncheck","selector":"#product-form input[name='trackStock']","name":"reg-product-no-stock-control"},
    {"action":"click","selector":"#product-form button[type='submit']","name":"reg-save-product"},
    {"action":"waitFor","selector":".data-row:has-text('QA REGRESSAO PRODUTO') [data-edit-product]","name":"reg-product-created","timeoutMs":10000},
    {"action":"click","selector":"#product-page-search","name":"reg-product-search-focus"},
    {"action":"press","selector":"#product-page-search","key":"7","name":"catalog-barcode-01"},
    {"action":"press","selector":"#product-page-search","key":"8","name":"catalog-barcode-02"},
    {"action":"press","selector":"#product-page-search","key":"9","name":"catalog-barcode-03"},
    {"action":"press","selector":"#product-page-search","key":"9","name":"catalog-barcode-04"},
    {"action":"press","selector":"#product-page-search","key":"8","name":"catalog-barcode-05"},
    {"action":"press","selector":"#product-page-search","key":"7","name":"catalog-barcode-06"},
    {"action":"press","selector":"#product-page-search","key":"6","name":"catalog-barcode-07"},
    {"action":"press","selector":"#product-page-search","key":"5","name":"catalog-barcode-08"},
    {"action":"press","selector":"#product-page-search","key":"4","name":"catalog-barcode-09"},
    {"action":"press","selector":"#product-page-search","key":"3","name":"catalog-barcode-10"},
    {"action":"press","selector":"#product-page-search","key":"2","name":"catalog-barcode-11"},
    {"action":"press","selector":"#product-page-search","key":"1","name":"catalog-barcode-12"},
    {"action":"press","selector":"#product-page-search","key":"0","name":"catalog-barcode-13"},
    {"action":"expectValue","selector":"#product-page-search","expected":"7899876543210","name":"catalog-barcode-order-preserved"},
    {"action":"expectText","selector":"[data-product-list]","expected":"QA REGRESSAO PRODUTO NOME MUITO LONGO PARA TESTAR CARRINHO RESPONSIVO","name":"catalog-barcode-result"},
    {"action":"fill","selector":"#product-page-search","value":"","name":"reg-product-search-clear"},

    {"action":"click","selector":"[data-route='customers']","name":"reg-open-customers"},
    {"action":"waitFor","selector":"#new-customer","name":"reg-customers-ready","timeoutMs":10000},
    {"action":"click","selector":"#new-customer","name":"reg-new-customer"},
    {"action":"waitFor","selector":"#customer-form","name":"reg-customer-form-ready","timeoutMs":5000},
    {"action":"fill","selector":"#customer-form input[name='name']","value":"QA Cliente Estavel","name":"reg-customer-name"},
    {"action":"fill","selector":"#customer-form input[name='document']","value":"12345678901","name":"reg-customer-document"},
    {"action":"click","selector":"#customer-form button[type='submit']","name":"reg-save-customer"},
    {"action":"waitFor","selector":".data-row:has-text('QA Cliente Estavel') [data-edit-customer]","name":"reg-customer-created","timeoutMs":10000},
    {"action":"click","selector":"#customer-page-search","name":"reg-customer-search-focus"},
    {"action":"press","selector":"#customer-page-search","key":"1","name":"customer-document-01"},
    {"action":"press","selector":"#customer-page-search","key":"2","name":"customer-document-02"},
    {"action":"press","selector":"#customer-page-search","key":"3","name":"customer-document-03"},
    {"action":"press","selector":"#customer-page-search","key":"4","name":"customer-document-04"},
    {"action":"press","selector":"#customer-page-search","key":"5","name":"customer-document-05"},
    {"action":"press","selector":"#customer-page-search","key":"6","name":"customer-document-06"},
    {"action":"press","selector":"#customer-page-search","key":"7","name":"customer-document-07"},
    {"action":"press","selector":"#customer-page-search","key":"8","name":"customer-document-08"},
    {"action":"press","selector":"#customer-page-search","key":"9","name":"customer-document-09"},
    {"action":"press","selector":"#customer-page-search","key":"0","name":"customer-document-10"},
    {"action":"press","selector":"#customer-page-search","key":"1","name":"customer-document-11"},
    {"action":"expectValue","selector":"#customer-page-search","expected":"12345678901","name":"customer-document-order-preserved"},
    {"action":"expectText","selector":"[data-customer-list]","expected":"QA Cliente Estavel","name":"customer-document-result"},

    {"action":"click","selector":"[data-route='checkout']","name":"reg-open-checkout"},
    {"action":"waitFor","selector":".checkout-layout","name":"reg-checkout-ready","timeoutMs":10000},
    {"action":"fill","selector":"#product-search","value":"QA REGRESSAO PRODUTO","name":"reg-find-long-product"},
    {"action":"waitFor","selector":".product-card[data-add-product]:has-text('QA REGRESSAO PRODUTO')","name":"reg-long-product-found","timeoutMs":10000},
    {"action":"click","selector":".product-card[data-add-product]:has-text('QA REGRESSAO PRODUTO')","name":"reg-add-long-product"},
    {"action":"waitFor","selector":".cart-line:has-text('QA REGRESSAO PRODUTO')","name":"reg-cart-line-ready","timeoutMs":10000},
    {"action":"expectVisible","selector":".cart-line [data-price-item]","name":"reg-cart-price-override-visible"},
    {"action":"expectVisible","selector":".cart-line .qty-control","name":"reg-cart-qty-visible"},
    {"action":"expectVisible","selector":".cart-line .line-total","name":"reg-cart-total-visible"},
    {"action":"expectNoHorizontalOverflow","selector":".sale-panel","tolerancePx":2,"name":"reg-sale-panel-no-overflow"},
    {"action":"expectNoHorizontalOverflow","selector":".cart-line","tolerancePx":2,"name":"reg-cart-line-no-overflow"},
    {"action":"screenshot","name":"reg-compact-cart"},

    {"action":"click","selector":"[data-pay='cash']","name":"reg-pay-cash"},
    {"action":"waitFor","selector":"#initial-cash","name":"reg-open-cash-required","timeoutMs":10000},
    {"action":"fill","selector":"#initial-cash","value":"0,00","name":"reg-initial-cash"},
    {"action":"click","selector":"#confirm-open-cash","name":"reg-open-cash"},
    {"action":"waitFor","selector":"#confirm-payment","name":"reg-payment-ready","timeoutMs":10000},
    {"action":"click","selector":"#confirm-payment","name":"reg-complete-sale"},
    {"action":"waitFor","selector":"#post-sale-actions","name":"reg-post-sale-ready","timeoutMs":15000},
    {"action":"click","selector":"#post-sale-new-sale","name":"reg-post-sale-new-sale"},

    {"action":"click","selector":".brand-mark","name":"reg-open-classic-home"},
    {"action":"waitFor","selector":"#classic-home-grid","name":"reg-classic-home-ready","timeoutMs":10000},
    {"action":"click","selector":"#classic-home-grid [data-classic-route='returns']","name":"reg-open-returns"},
    {"action":"waitFor","selector":"[data-returns-ui]","name":"reg-returns-ready","timeoutMs":10000},
    {"action":"waitFor","selector":"[data-return-sale]","name":"reg-return-sales-ready","timeoutMs":10000},
    {"action":"click","selector":"[data-return-sale]","name":"reg-select-latest-sale"},
    {"action":"waitFor","selector":"[data-return-item]","name":"reg-return-items-ready","timeoutMs":10000},
    {"action":"check","selector":"[data-return-check]","name":"reg-select-return-item"},
    {"action":"fill","selector":"[data-return-qty]","value":"1","name":"reg-return-qty"},
    {"action":"fill","selector":"#return-reason","value":"QA devolução operacional","name":"reg-return-reason"},
    {"action":"selectOption","selector":"#return-refund-method","value":"CASH","name":"reg-return-refund"},
    {"action":"expectText","selector":"[data-return-draft-total]","expected":"10,00","name":"reg-return-total"},
    {"action":"click","selector":"#confirm-return","name":"reg-confirm-return"},
    {"action":"waitFor","selector":"#returns-status[data-tone='ok']","name":"reg-return-success","timeoutMs":15000},
    {"action":"expectText","selector":"#returns-status","expected":"concluída","name":"reg-return-success-copy"},
    {"action":"expectText","selector":".return-history","expected":"Concluída","name":"reg-return-history"},
    {"action":"expectNoHorizontalOverflow","selector":"[data-returns-ui]","tolerancePx":2,"name":"reg-returns-no-overflow"},
    {"action":"screenshot","name":"reg-return-completed","fullPage":true}
  ]
}
