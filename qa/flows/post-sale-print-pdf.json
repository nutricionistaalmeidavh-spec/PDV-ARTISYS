{
  "name":"post-sale-print-pdf",
  "steps":[
    {"uses":"home.json"},
    {"action":"click","selector":"[data-route='products']","name":"pdf-open-products"},
    {"action":"waitFor","selector":"#new-product","name":"pdf-products-ready","timeoutMs":10000},
    {"action":"click","selector":"#new-product","name":"pdf-new-product"},
    {"action":"fill","selector":"#product-form input[name='name']","value":"QA Comprovante PDF","name":"pdf-product-name"},
    {"action":"fill","selector":"#product-form input[name='sku']","value":"QA-PDF-001","name":"pdf-product-sku"},
    {"action":"fill","selector":"#product-form input[name='salePrice']","value":"12,34","name":"pdf-product-price"},
    {"action":"fill","selector":"#product-form input[name='cost']","value":"5,00","name":"pdf-product-cost"},
    {"action":"uncheck","selector":"#product-form input[name='trackStock']","name":"pdf-product-no-stock"},
    {"action":"click","selector":"#product-form button[type='submit']","name":"pdf-save-product"},
    {"action":"click","selector":"[data-route='checkout']","name":"pdf-open-checkout"},
    {"action":"waitFor","selector":".checkout-layout","name":"pdf-checkout-ready","timeoutMs":10000},
    {"action":"click","selector":".product-card[data-add-product]:has-text('QA Comprovante PDF')","name":"pdf-add-product"},
    {"action":"waitFor","selector":".cart-line","name":"pdf-cart-ready","timeoutMs":10000},
    {"action":"click","selector":"[data-pay=\"cash\"]","name":"pdf-cash-payment"},
    {"action":"waitFor","selector":"#initial-cash","name":"pdf-cash-open-required","timeoutMs":10000},
    {"action":"fill","selector":"#initial-cash","value":"0,00","name":"pdf-initial-cash"},
    {"action":"click","selector":"#confirm-open-cash","name":"pdf-open-cash"},
    {"action":"waitFor","selector":"#confirm-payment","name":"pdf-payment-ready","timeoutMs":10000},
    {"action":"click","selector":"#confirm-payment","name":"pdf-complete-sale"},
    {"action":"waitFor","selector":"#post-sale-actions","name":"pdf-post-sale-ready","timeoutMs":15000},
    {"action":"expectVisible","selector":"#post-sale-print","name":"pdf-print-visible"},
    {"action":"expectVisible","selector":"#post-sale-save-pdf","name":"pdf-save-visible"},
    {"action":"expectSameRow","selectors":["#post-sale-print","#post-sale-save-pdf"],"name":"pdf-actions-same-row"},
    {"action":"screenshot","name":"post-sale-print-pdf-actions"},
    {"action":"click","selector":"#post-sale-save-pdf","name":"pdf-save-native"},
    {"action":"waitFor","selector":"#post-sale-receipt-status","name":"pdf-save-status","timeoutMs":15000},
    {"action":"expectText","selector":"#post-sale-receipt-status","expected":"PDF salvo com sucesso","name":"pdf-save-success"},
    {"action":"expectFile","directory":"qa-artifacts/pdf","suffix":".pdf","minBytes":100,"startsWith":"%PDF-","createdAfterRunStart":true,"name":"pdf-file-valid"},
    {"action":"click","selector":"#post-sale-print","name":"pdf-print-simulated"},
    {"action":"waitForTimeout","timeoutMs":300,"name":"pdf-wait-print"},
    {"action":"expectText","selector":"#post-sale-receipt-status","expected":"Comprovante enviado para impressão","name":"pdf-print-success"},
    {"action":"click","selector":"#post-sale-new-sale","name":"pdf-new-sale"},
    {"action":"expectText","selector":".cart-list","expected":"Nenhum item","name":"pdf-new-sale-usable"},
    {"action":"expectNoHorizontalOverflow","name":"pdf-no-overflow"}
  ]
}