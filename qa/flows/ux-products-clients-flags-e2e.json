    {"action":"fill","selector":"#customer-page-search","value":"QA Flag Master Customer Edited","name":"flags-on-customer-filter-edited"},
    {"action":"expectText","selector":".customers-master-list","expected":"QA Flag Master Customer Edited","name":"flags-on-customer-edit-visible"},
    {"action":"screenshot","name":"flags-on-customers-master-detail-crud","fullPage":true},

