    {"action":"selectOption","selector":"#enterprise-po-form select[name='locationId']","value":{"label":"Estoque principal"},"name":"p0-po-location"},
    {"action":"click","selector":"#enterprise-po-form button[type='submit']","name":"p0-create-po"},
