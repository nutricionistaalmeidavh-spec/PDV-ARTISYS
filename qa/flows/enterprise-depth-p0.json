    {"action":"waitFor","selector":"#enterprise-order-form","name":"p0-order-form-ready","timeoutMs":10000},
    {"action":"selectOption","selector":"#enterprise-order-form select[name='customerId']","value":{"label":"QA Cliente P0"},"name":"p0-order-customer"},
    {"action":"selectOption","selector":"#enterprise-order-form select[name='productId']","value":{"label":"QA Produto P0"},"name":"p0-order-product"},
    {"action":"fill","selector":"#enterprise-order-form input[name='quantity']","value":"2","name":"p0-order-quantity"},
    {"action":"selectOption","selector":"#enterprise-order-form select[name='locationId']","value":{"label":"Estoque principal"},"name":"p0-order-location"},
    {"action":"selectOption","selector":"#enterprise-order-form select[name='fulfillmentType']","value":"PICKUP","name":"p0-order-pickup"},
    {"action":"click","selector":"#enterprise-order-form button[type='submit']","name":"p0-create-order"},
