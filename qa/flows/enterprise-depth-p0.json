{
  "name":"enterprise-depth-p0",
  "steps":[
    {"uses":"home.json"},

    {"action":"click","selector":"[data-route='products']","name":"p0-open-products"},
    {"action":"waitFor","selector":"#new-product","name":"p0-products-ready","timeoutMs":10000},
    {"action":"click","selector":"#new-product","name":"p0-new-product"},
    {"action":"fill","selector":"#product-form input[name='name']","value":"QA Produto P0","name":"p0-product-name"},
    {"action":"fill","selector":"#product-form input[name='sku']","value":"QA-P0","name":"p0-product-sku"},
    {"action":"fill","selector":"#product-form input[name='salePrice']","value":"20,00","name":"p0-product-price"},
    {"action":"fill","selector":"#product-form input[name='cost']","value":"8,00","name":"p0-product-cost"},
    {"action":"click","selector":"#product-form button[type='submit']","name":"p0-save-product"},
    {"action":"expectText","selector":".data-card:not([data-kit-combo-admin])","expected":"QA Produto P0","name":"p0-product-created"},

    {"action":"click","selector":"[data-route='customers']","name":"p0-open-customers"},
    {"action":"waitFor","selector":"#new-customer","name":"p0-customers-ready","timeoutMs":10000},
