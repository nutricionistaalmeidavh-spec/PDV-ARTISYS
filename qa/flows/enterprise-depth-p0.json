    {"action":"click","selector":"[data-action='dispatch']","name":"p0-dispatch-transfer"},
    {"action":"waitFor","selector":"[data-action='receive']","name":"p0-transfer-transit-ready","timeoutMs":10000},
    {"action":"click","selector":"[data-action='receive']","name":"p0-receive-transfer"},
    {"action":"expectText","selector":"[data-list]","expected":"RECEIVED","name":"p0-transfer-received"},

