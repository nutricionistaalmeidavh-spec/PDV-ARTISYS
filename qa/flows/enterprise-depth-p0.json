    {"action":"expectText","selector":"[data-list]","expected":"CONFIRMED","name":"p0-order-confirmed"},

    {"action":"click","selector":"[data-enterprise-back]","name":"p0-back-check-reservation"},
    {"action":"waitFor","selector":"#enterprise-depth-entry","name":"p0-entry-check-reservation","timeoutMs":10000},
    {"action":"click","selector":"#enterprise-depth-entry [data-open='logistics']","name":"p0-open-logistics-reservation"},
    {"action":"waitFor","selector":"[data-reservations]","name":"p0-reservations-ready","timeoutMs":10000},
    {"action":"expectText","selector":"[data-reservations]","expected":"QA Produto P0","name":"p0-reservation-product"},

    {"action":"click","selector":"[data-enterprise-back]","name":"p0-back-to-order"},
    {"action":"waitFor","selector":"#enterprise-depth-entry","name":"p0-entry-return-order","timeoutMs":10000},
    {"action":"click","selector":"#enterprise-depth-entry [data-open='orders']","name":"p0-reopen-orders"},
    {"action":"waitFor","selector":"[data-action='fulfill']","name":"p0-order-fulfill-ready","timeoutMs":10000},
    {"action":"selectOption","selector":"#enterprise-fulfillment-method","value":"PIX","name":"p0-fulfillment-pix"},
    {"action":"click","selector":"[data-action='fulfill']","name":"p0-fulfill-order"},
    {"action":"expectText","selector":"[data-list]","expected":"FULFILLED","name":"p0-order-fulfilled"},

    {"action":"click","selector":"[data-enterprise-back]","name":"p0-back-final-inventory"},
    {"action":"waitFor","selector":"#ops-inventory-body","name":"p0-inventory-final-ready","timeoutMs":10000},
    {"action":"expectText","selector":"#ops-inventory-body","expected":"QA Produto P0","name":"p0-inventory-product"},
    {"action":"expectText","selector":"#ops-inventory-body","expected":"4 UN","name":"p0-inventory-balance"},
    {"action":"click","selector":"[data-route='reports']","name":"p0-open-reports"},
    {"action":"waitFor","selector":".report-v2-page","name":"p0-reports-ready","timeoutMs":10000},
    {"action":"click","selector":"[data-report-view='products']","name":"p0-report-products"},
    {"action":"expectText","selector":".report-v2-page","expected":"QA Produto P0","name":"p0-report-product-visible"},
    {"action":"screenshot","name":"phase9-enterprise-depth-p0","fullPage":true}
  ]
