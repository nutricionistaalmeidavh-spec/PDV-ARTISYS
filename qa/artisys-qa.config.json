{
  "schemaVersion": 1,
  "systemId": "pdv-artisys",
  "mode": "electron",
  "defaultEnvironment": "ci",
  "defaultDemo": "quick-30s",
  "defaultDemoProfile": "erp-finance-ci",
  "defaultViewport": "desktop",
  "demoCaptureViewport": {
    "width": 1440,
    "height": 900
  },
  "capture": {
    "video": true,
    "screenshotEachStep": false,
    "fps": 8
  },
  "electron": {
    "entry": "desktop/main.cjs",
    "executablePath": "../node_modules/electron/dist/electron",
    "args": [
      "--no-sandbox"
    ]
  },
  "environments": {
    "ci": {
      "env": {
        "NODE_ENV": "test",
        "ARTISYS_QA": "1",
        "ARTISYS_QA_AUTO_ADMIN": "1",
        "ARTISYS_QA_AUTO_LOCAL": "1",
        "ARTISYS_QA_PDF_DIR": "../qa-artifacts/pdf",
        "ARTISYS_QA_SIMULATE_PRINTER": "1",
        "ARTISYS_QA_NO_PRINTERS": "1",
        "PDV_ENABLE_LAN": "false",
        "PDV_AUTO_PRINT": "false"
      }
    }
  },
  "demoProfiles": {
    "erp-finance-ci": {
      "adapter": "runtime/adapters/erp-finance-ci.mjs"
    },
    "tutorials-p0": {
      "adapter": "runtime/adapters/tutorials-p0.mjs"
    }
  },
  "defaultFlow": "all-pages-audit",
  "flows": {
    "all-pages-audit": "flows/all-pages-audit.json",
    "access-center-partial-permissions": "flows/access-center-partial-permissions.json",
    "access-center-ergonomic": "flows/access-center-ergonomic.json",
    "delivery-pickup-operational": "flows/delivery-pickup-operational-e2e.json"
  },
  "qaProfiles": {
    "quick": {
      "flows": [],
      "criticalFlows": []
    },
    "full": {
      "flows": [],
      "criticalFlows": []
    },
    "release": {
      "flows": [],
      "criticalFlows": []
    }
  },
  "demos": {
    "quick-30s": {
      "file": "demo/quick-30s.json",
      "preset": "reels-9x16",
      "durationTargetSec": 30
    },
    "overview-60s": {
      "file": "demo/overview-60s.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 60
    },
    "01-fazer-uma-venda": {
      "file": "demo/tutorials/01-fazer-uma-venda.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 28,
      "profile": "tutorials-p0"
    },
    "02-buscar-adicionar-produto": {
      "file": "demo/tutorials/02-buscar-adicionar-produto.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 18,
      "profile": "tutorials-p0"
    },
    "03-alterar-quantidade-remover-item": {
      "file": "demo/tutorials/03-alterar-quantidade-remover-item.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 18,
      "profile": "tutorials-p0"
    },
    "04-aplicar-desconto": {
      "file": "demo/tutorials/04-aplicar-desconto.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 22,
      "profile": "tutorials-p0"
    },
    "05-identificar-cliente-vendedor": {
      "file": "demo/tutorials/05-identificar-cliente-vendedor.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 20,
