{
  "schemaVersion": 1,
  "systemId": "pdv-artisys",
  "mode": "electron",
  "defaultEnvironment": "ci",
  "defaultDemo": "quick-30s",
  "defaultDemoProfile": "erp-finance-ci",
  "defaultViewport": "desktop",
  "demoCaptureViewport": { "width": 1440, "height": 900 },
  "capture": { "video": true, "screenshotEachStep": false, "fps": 8 },
  "electron": {
    "entry": "desktop/main.cjs",
    "executablePath": "../node_modules/electron/dist/electron",
    "args": ["--no-sandbox"]
  },
  "environments": {
    "ci": {
      "env": {
        "NODE_ENV": "test",
        "ARTISYS_QA": "1",
        "ARTISYS_QA_PDF_DIR": "../qa-artifacts/pdf",
        "ARTISYS_QA_SIMULATE_PRINTER": "1",
        "ARTISYS_QA_NO_PRINTERS": "1",
        "PDV_ENABLE_LAN": "false",
        "PDV_AUTO_PRINT": "false"
      }
    }
  },
  "demoProfiles": {
    "erp-finance-ci": { "adapter": "runtime/adapters/erp-finance-ci.mjs" }
  },
  "flows": {},
  "qaProfiles": {
    "quick": { "flows": [], "criticalFlows": [] },
    "full": { "flows": [], "criticalFlows": [] },
    "release": { "flows": [], "criticalFlows": [] }
  },
  "demos": {
    "quick-30s": { "file": "demo/quick-30s.json", "preset": "reels-9x16", "durationTargetSec": 30 },
    "overview-60s": { "file": "demo/overview-60s.json", "preset": "landscape-16x9", "durationTargetSec": 60 }
  }
}
