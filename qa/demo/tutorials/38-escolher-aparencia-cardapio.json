{
  "name": "38-escolher-aparencia-cardapio",
  "title": "Escolher aparência do cardápio digital",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.food.setup",
      "scenario": "appearance"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 80
    },
    {
      "action": "click",
      "selector": "[data-route='FOOD']",
      "name": "abrir-alimentacao",
      "holdMs": 100
    },
    {
      "action": "click",
      "selector": "[data-food-capability='RESTAURANT']",
      "name": "abrir-mesas",
      "holdMs": 160
    },
    {
      "action": "waitFor",
      "selector": "[data-public-ordering-panel]",
      "name": "cardapio-publico-pronto",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 120
    },
    {
      "action": "click",
      "selector": ".menu-layout-option:has(input[value='PREMIUM']) .menu-layout-copy",
      "name": "escolher-visual-gastronomico",
      "timeoutMs": 10000,
      "holdMs": 180
    },
    {
      "action": "click",
      "selector": "#apply-menu-layout",
      "name": "aplicar-aparencia",
      "holdMs": 300
    },
    {
      "action": "expectText",
      "selector": "#toast-root",
      "name": "aparencia-aplicada",
      "expected": "Aparência do cardápio aplicada",
      "timeoutMs": 10000,
      "holdMs": 250
    },
    {
      "action": "setViewportSize",
      "width": 412,
      "height": 915,
      "name": "visao-cliente"
    },
    {
      "action": "goto",
      "urlFrom": "foodMenuUrl",
      "name": "abrir-cardapio-pronto"
    },
    {
      "action": "expectVisible",
      "selector": "html[data-menu-layout='premium']",
      "name": "premium-ativo",
      "timeoutMs": 15000,
      "holdMs": 120
    },
    {
      "action": "expectVisible",
      "selector": ".product-card.has-photo:has-text('Hambúrguer Artesanal')",
      "name": "produto-com-foto",
      "timeoutMs": 15000,
      "holdMs": 180
    },
    {
      "action": "expectVisible",
      "selector": ".product-card:has-text('Hambúrguer Artesanal') img.product-photo",
      "name": "foto-cardapio",
      "timeoutMs": 15000,
      "holdMs": 500
    },
    {
      "action": "expectText",
      "selector": ".product-card:has-text('Hambúrguer Artesanal')",
      "name": "descricao-cardapio",
      "expected": "Pão brioche",
      "timeoutMs": 10000,
      "holdMs": 450
    }
  ]
}
