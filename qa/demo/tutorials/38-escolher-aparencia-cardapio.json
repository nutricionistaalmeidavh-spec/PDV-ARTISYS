{
  "name": "38-escolher-aparencia-cardapio",
  "title": "Escolher aparência do cardápio digital",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.food.setup",
      "scenario": "appearance"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 150
    },
    {
      "action": "click",
      "selector": "[data-route='FOOD']",
      "name": "abrir-alimentacao",
      "holdMs": 300
    },
    {
      "action": "click",
      "selector": "[data-food-capability='RESTAURANT']",
      "name": "abrir-mesas",
      "holdMs": 400
    },
    {
      "action": "waitFor",
      "selector": "[data-public-ordering-panel]",
      "name": "cardapio-publico-pronto",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 250
    },
    {
      "action": "check",
      "selector": "input[name='menuLayout'][value='PREMIUM']",
      "name": "escolher-visual-gastronomico",
      "timeoutMs": 10000,
      "holdMs": 450
    },
    {
      "action": "click",
      "selector": "#apply-menu-layout",
      "name": "aplicar-aparencia",
      "holdMs": 550
    },
    {
      "action": "expectText",
      "selector": "#toast-root",
      "name": "aparencia-aplicada",
      "expected": "Aparência do cardápio aplicada",
      "timeoutMs": 10000,
      "holdMs": 800
    }
  ]
}
