{
  "name": "42-garcom-acompanhar-pedido",
  "title": "Garçom acompanhar pedido da mesa",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.food.setup",
      "scenario": "waiter"
    },
    {
      "action": "setViewportSize",
      "width": 390,
      "height": 844,
      "name": "viewport-garcom"
    },
    {
      "action": "desktopConfig",
      "name": "capturar-servidor",
      "saveAs": {
        "qaApiBase": "apiBase"
      }
    },
    {
      "action": "goto",
      "urlFrom": "qaApiBase",
      "path": "/mobile",
      "name": "abrir-garcom"
    },
    {
      "action": "waitFor",
      "selector": "#login",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 80
    },
    {
      "action": "waitFor",
      "selector": "#login",
      "name": "login-garcom",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 150
    },
    {
      "action": "fill",
      "selector": "#login input[name='id']",
      "name": "id-garcom",
      "valueFrom": "waiterId",
      "holdMs": 100
    },
    {
      "action": "fill",
      "selector": "#login input[name='key']",
      "name": "chave-garcom",
      "valueFrom": "waiterKey",
      "holdMs": 100
    },
    {
      "action": "click",
      "selector": "#login button[type='submit']",
      "name": "conectar-garcom",
      "holdMs": 500
    },
    {
      "action": "expectVisible",
      "selector": ".waiter-layout",
      "name": "salao-garcom",
      "timeoutMs": 15000,
      "holdMs": 300
    },
    {
      "action": "click",
      "selector": "[data-waiter-table]:not(.free)",
      "name": "abrir-mesa",
      "holdMs": 350
    },
    {
      "action": "click",
      "selector": "[data-waiter-tab='orders']",
      "name": "abrir-comanda",
      "holdMs": 350
    },
    {
      "action": "expectText",
      "selector": ".selected-orders",
      "name": "pedido-visivel",
      "expected": "Hambúrguer Artesanal",
      "timeoutMs": 10000,
      "holdMs": 400
    },
    {
      "action": "expectText",
      "selector": ".selected-orders",
      "name": "estado-producao",
      "expected": "Novo pedido",
      "timeoutMs": 10000,
      "holdMs": 700
    }
  ]
}
