{
  "name": "01-fazer-uma-venda",
  "title": "Como fazer uma venda",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.setup",
      "scenario": "sale-complete"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 250
    },
    {
      "action": "click",
      "selector": "button[data-route='checkout']",
      "name": "abrir-balcao",
      "holdMs": 600
    },
    {
      "action": "fill",
      "selector": "#product-search",
      "name": "buscar-produto",
      "value": "Produto Tutorial",
      "holdMs": 500
    },
    {
      "action": "click",
      "selector": "[data-add-product='tutorial-product']",
      "name": "adicionar-produto",
      "holdMs": 700
    },
    {
      "action": "expectText",
      "selector": ".cart-list",
      "name": "produto-no-carrinho",
      "expected": "Produto Tutorial",
      "timeoutMs": 10000,
      "holdMs": 700
    },
    {
      "action": "click",
      "selector": "[data-pay='cash']",
      "name": "escolher-dinheiro",
      "holdMs": 700
    },
    {
      "action": "waitFor",
      "selector": "#confirm-payment",
      "name": "pagamento-pronto",
      "state": "visible",
      "timeoutMs": 10000,
      "holdMs": 500
    },
    {
      "action": "click",
      "selector": "#confirm-payment",
      "name": "concluir-venda",
      "holdMs": 900
    },
    {
      "action": "expectText",
      "selector": ".cart-head",
      "name": "venda-concluida",
      "expected": "Itens da venda (0)",
      "timeoutMs": 10000,
      "holdMs": 1200
    }
  ]
}
