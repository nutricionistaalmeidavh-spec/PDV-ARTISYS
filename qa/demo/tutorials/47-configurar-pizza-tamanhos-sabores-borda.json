{
  "name": "47-configurar-pizza-tamanhos-sabores-borda",
  "title": "Criar a ficha técnica do sabor Calabresa",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.food.setup",
      "scenario": "pizza-recipe"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 80
    },
    {
      "action": "click",
      "selector": "button[data-route='catalog']",
      "name": "abrir-cadastros",
      "holdMs": 60
    },
    {
      "action": "click",
      "selector": "button[data-flow-route='inventory']",
      "name": "abrir-estoque",
      "holdMs": 80
    },
    {
      "action": "waitFor",
      "selector": "#inventory-master-actions",
      "name": "estoque-pronto",
      "state": "visible",
      "timeoutMs": 10000,
      "holdMs": 50
    },
    {
      "action": "click",
      "selector": "#inventory-new-recipe",
      "name": "nova-ficha-sabor",
      "holdMs": 80
    },
    {
      "action": "waitFor",
      "selector": "#recipe-product-form",
      "name": "form-sabor",
      "state": "visible",
      "timeoutMs": 10000,
      "holdMs": 50
    },
    {
      "action": "fill",
      "selector": "#recipe-product-form input[name='name']",
      "name": "nome-sabor",
      "value": "Sabor Calabresa",
      "holdMs": 40
    },
    {
      "action": "fill",
      "selector": "#recipe-product-form input[name='sku']",
      "name": "sku-sabor",
      "value": "PIZ-FL-CAL",
      "holdMs": 35
    },
    {
      "action": "selectOption",
      "selector": "#recipe-product-form select[name='categoryId']",
      "name": "categoria-pizzas",
      "value": "tutorial-cat-pizzas",
      "holdMs": 40
    },
    {
      "action": "fill",
      "selector": "#recipe-sale-price",
      "name": "preco-interno",
      "value": "0,00",
      "holdMs": 30
    },
    {
      "action": "selectOption",
      "selector": "#recipe-product-form select[name='productionDestination']",
      "name": "destino-interno",
      "value": "DIRECT",
      "holdMs": 40
    },
    {
      "action": "fill",
      "selector": "#recipe-product-form input[name='yieldQuantity']",
      "name": "rendimento",
      "value": "1",
      "holdMs": 30
    },
    {
      "action": "fill",
      "selector": "#recipe-product-form input[name='portionQuantity']",
      "name": "porcao",
      "value": "1",
      "holdMs": 30
    },
    {
      "action": "click",
      "selector": "#recipe-create-add",
      "name": "adicionar-mussarela",
      "holdMs": 30
    },
    {
      "action": "selectOption",
      "selector": "[data-recipe-create-row='0'] [data-recipe-product]",
      "name": "selecionar-mussarela",
      "value": "tutorial-pizza-mozzarella",
      "holdMs": 40
    },
    {
      "action": "fill",
      "selector": "[data-recipe-create-row='0'] [data-recipe-quantity]",
      "name": "quantidade-mussarela",
      "value": "0.2",
      "holdMs": 30
    },
    {
      "action": "click",
      "selector": "#recipe-create-add",
      "name": "adicionar-calabresa",
      "holdMs": 30
    },
    {
      "action": "selectOption",
      "selector": "[data-recipe-create-row='1'] [data-recipe-product]",
      "name": "selecionar-calabresa",
      "value": "tutorial-pizza-calabresa",
      "holdMs": 40
    },
    {
      "action": "fill",
      "selector": "[data-recipe-create-row='1'] [data-recipe-quantity]",
      "name": "quantidade-calabresa",
      "value": "0.15",
      "holdMs": 30
    },
    {
      "action": "click",
      "selector": "#recipe-create-add",
      "name": "adicionar-cebola",
      "holdMs": 30
    },
    {
      "action": "selectOption",
      "selector": "[data-recipe-create-row='2'] [data-recipe-product]",
      "name": "selecionar-cebola",
      "value": "tutorial-pizza-onion",
      "holdMs": 40
    },
    {
      "action": "fill",
      "selector": "[data-recipe-create-row='2'] [data-recipe-quantity]",
      "name": "quantidade-cebola",
      "value": "0.05",
      "holdMs": 30
    },
    {
      "action": "click",
      "selector": "#recipe-create-add",
      "name": "adicionar-oregano",
      "holdMs": 30
    },
    {
      "action": "selectOption",
      "selector": "[data-recipe-create-row='3'] [data-recipe-product]",
      "name": "selecionar-oregano",
      "value": "tutorial-pizza-oregano",
      "holdMs": 40
    },
    {
      "action": "fill",
      "selector": "[data-recipe-create-row='3'] [data-recipe-quantity]",
      "name": "quantidade-oregano",
      "value": "0.002",
      "holdMs": 30
    },
    {
      "action": "fill",
      "selector": "#recipe-product-form textarea[name='preparationNotes']",
      "name": "preparo-sabor",
      "value": "Distribuir mussarela, calabresa e cebola; finalizar com orégano.",
      "holdMs": 45
    },
    {
      "action": "expectText",
      "selector": ".recipe-summary-grid",
      "name": "custo-sabor",
      "expected": "Custo / porção",
      "timeoutMs": 10000,
      "holdMs": 120
    },
    {
      "action": "click",
      "selector": "#recipe-product-form button[type='submit']",
      "name": "salvar-sabor",
      "holdMs": 400
    },
    {
      "action": "expectText",
      "selector": "#inventory-recipes-card",
      "name": "sabor-salvo",
      "expected": "Sabor Calabresa",
      "timeoutMs": 15000,
      "holdMs": 350
    }
  ]
}
