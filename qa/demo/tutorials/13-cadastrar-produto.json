{
  "name": "13-cadastrar-produto",
  "title": "Cadastrar produto e finalizar a primeira venda",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.setup",
      "scenario": "product-create"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "click",
      "selector": "button[data-route='catalog']",
      "name": "abrir-cadastros",
      "holdMs": 100
    },
    {
      "action": "click",
      "selector": "button[data-flow-route='inventory']",
      "name": "abrir-estoque",
      "holdMs": 150
    },
    {
      "action": "waitFor",
      "selector": "#inventory-quick-product",
      "name": "estoque-pronto",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "#inventory-quick-product",
      "name": "abrir-cadastro-rapido",
      "holdMs": 150
    },
    {
      "action": "waitFor",
      "selector": "#quick-stock-product-form",
      "name": "cadastro-pronto",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "fill",
      "selector": "#quick-stock-name",
      "name": "nome-produto",
      "value": "Produto Novo Tutorial",
      "holdMs": 100
    },
    {
      "action": "fill",
      "selector": "#quick-stock-price",
      "name": "preco-produto",
      "value": "12,50",
      "holdMs": 100
    },
    {
      "action": "fill",
      "selector": "#quick-stock-quantity",
      "name": "quantidade-inicial",
      "value": "12",
      "holdMs": 100
    },
    {
      "action": "check",
      "selector": "#quick-stock-product-form input[name=\"publish\"]",
      "name": "publicar-para-venda",
      "holdMs": 100
    },
    {
      "action": "click",
      "selector": "#quick-stock-product-form button[type=\"submit\"][value=\"done\"]",
      "name": "salvar-produto",
      "holdMs": 200
    },
    {
      "action": "waitFor",
      "selector": "[data-quick-stock-success]",
      "name": "cadastro-confirmado",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "expectText",
      "selector": "[data-quick-stock-result]",
      "name": "produto-publicado",
      "expected": "No Cardápio e no Balcão",
      "timeoutMs": 10000,
      "holdMs": 350
    },
    {
      "action": "click",
      "selector": "[data-quick-stock-checkout]",
      "name": "ir-para-balcao",
      "holdMs": 200
    },
    {
      "action": "waitFor",
      "selector": "#product-search",
      "name": "balcao-pronto",
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "fill",
      "selector": "#product-search",
      "name": "buscar-produto-balcao",
      "value": "Produto Novo Tutorial",
      "holdMs": 200
    },
    {
      "action": "click",
      "selector": ".product-grid [data-add-product]:has-text(\"Produto Novo Tutorial\")",
      "name": "adicionar-produto-na-venda",
      "holdMs": 180
    },
    {
      "action": "expectText",
      "selector": ".cart-list",
      "name": "produto-no-carrinho",
      "expected": "Produto Novo Tutorial",
      "timeoutMs": 10000,
      "holdMs": 300
    },
    {
      "action": "click",
      "selector": "#finalize-sale",
      "name": "finalizar-venda",
      "holdMs": 200
    },
    {
      "action": "waitFor",
      "selector": "#confirm-payment",
      "name": "pagamento-pronto",
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "expectText",
      "selector": ".payment-list",
      "name": "pagamento-dinheiro",
      "expected": "Dinheiro",
      "timeoutMs": 5000,
      "holdMs": 300
    },
    {
      "action": "click",
      "selector": "#confirm-payment",
      "name": "confirmar-pagamento",
      "holdMs": 150
    },
    {
      "action": "expectText",
      "selector": "#toast-root",
      "name": "venda-finalizada",
      "expected": "finalizada.",
      "timeoutMs": 15000,
      "holdMs": 650
    }
  ]
}
