{
  "name": "46-criar-ficha-tecnica-pizza-calabresa",
  "title": "Criar a ficha técnica base da pizza",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.food.setup",
      "scenario": "pizza-recipe"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 80
    },
    {
      "action": "click",
      "selector": "button[data-route='catalog']",
      "name": "abrir-cadastros",
      "holdMs": 60
    },
    {
      "action": "click",
      "selector": "button[data-flow-route='inventory']",
      "name": "abrir-estoque",
      "holdMs": 80
    },
    {
      "action": "waitFor",
      "selector": "#inventory-master-actions",
      "name": "estoque-pronto",
      "state": "visible",
      "timeoutMs": 10000,
      "holdMs": 50
    },
    {
      "action": "click",
      "selector": "#inventory-new-recipe",
      "name": "nova-ficha-base",
      "holdMs": 80
    },
    {
      "action": "waitFor",
      "selector": "#recipe-product-form",
      "name": "form-base",
      "state": "visible",
      "timeoutMs": 10000,
      "holdMs": 50
    },
    {
      "action": "fill",
      "selector": "#recipe-product-form input[name='name']",
      "name": "nome-pizza",
      "value": "Pizza Artesanal",
      "holdMs": 40
    },
    {
      "action": "fill",
      "selector": "#recipe-product-form input[name='sku']",
      "name": "sku-pizza",
      "value": "PIZZA-001",
      "holdMs": 35
    },
    {
      "action": "selectOption",
      "selector": "#recipe-product-form select[name='categoryId']",
      "name": "categoria-pizzas",
      "value": "tutorial-cat-pizzas",
      "holdMs": 40
    },
    {
      "action": "fill",
      "selector": "#recipe-sale-price",
      "name": "preco-base",
      "value": "35,00",
      "holdMs": 40
    },
    {
      "action": "selectOption",
      "selector": "#recipe-product-form select[name='productionDestination']",
      "name": "destino-cozinha",
      "value": "PRODUCTION:tutorial-kds",
      "holdMs": 50
    },
    {
      "action": "fill",
      "selector": "#recipe-product-form input[name='yieldQuantity']",
      "name": "rendimento",
      "value": "1",
      "holdMs": 30
    },
    {
      "action": "fill",
      "selector": "#recipe-product-form input[name='portionQuantity']",
      "name": "porcao",
      "value": "1",
      "holdMs": 30
    },
    {
      "action": "fill",
      "selector": "#recipe-product-form input[name='prepTimeMinutes']",
      "name": "tempo-preparo",
      "value": "20",
      "holdMs": 30
    },
    {
      "action": "click",
      "selector": "#recipe-create-add",
      "name": "adicionar-massa",
      "holdMs": 35
    },
    {
      "action": "selectOption",
      "selector": "[data-recipe-create-row='0'] [data-recipe-product]",
      "name": "selecionar-massa",
      "value": "tutorial-pizza-dough",
      "holdMs": 45
    },
    {
      "action": "fill",
      "selector": "[data-recipe-create-row='0'] [data-recipe-quantity]",
      "name": "quantidade-massa",
      "value": "1",
      "holdMs": 35
    },
    {
      "action": "click",
      "selector": "#recipe-create-add",
      "name": "adicionar-molho",
      "holdMs": 35
    },
    {
      "action": "selectOption",
      "selector": "[data-recipe-create-row='1'] [data-recipe-product]",
      "name": "selecionar-molho",
      "value": "tutorial-pizza-tomato-sauce",
      "holdMs": 45
    },
    {
      "action": "fill",
      "selector": "[data-recipe-create-row='1'] [data-recipe-quantity]",
      "name": "quantidade-molho",
      "value": "0.2",
      "holdMs": 35
    },
    {
      "action": "fill",
      "selector": "#recipe-product-form textarea[name='preparationNotes']",
      "name": "preparo-base",
      "value": "Abrir a massa, espalhar o molho e finalizar conforme os sabores escolhidos.",
      "holdMs": 50
    },
    {
      "action": "expectText",
      "selector": ".recipe-summary-grid",
      "name": "custo-base",
      "expected": "Custo / porção",
      "timeoutMs": 10000,
      "holdMs": 120
    },
    {
      "action": "click",
      "selector": "#recipe-product-form button[type='submit']",
      "name": "salvar-base",
      "holdMs": 400
    },
    {
      "action": "expectText",
      "selector": "#inventory-recipes-card",
      "name": "base-salva",
      "expected": "Pizza Artesanal",
      "timeoutMs": 15000,
      "holdMs": 200
    },
    {
      "action": "capability",
      "name": "tutorial.food.photo",
      "productName": "Pizza Artesanal",
      "kind": "pizza",
      "publish": true,
      "description": "Massa artesanal e molho da casa. Escolha tamanho, sabores e borda."
    },
    {
      "action": "reload",
      "name": "recarregar-com-foto"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "foto-pronta",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 80
    },
    {
      "action": "click",
      "selector": "button[data-route='catalog']",
      "name": "voltar-cadastros",
      "holdMs": 50
    },
    {
      "action": "click",
      "selector": "button[data-flow-route='products']",
      "name": "abrir-cardapio",
      "holdMs": 120
    },
    {
      "action": "expectText",
      "selector": "[data-products-canonical='true']",
      "name": "pizza-no-cardapio",
      "expected": "Pizza Artesanal",
      "timeoutMs": 10000,
      "holdMs": 180
    },
    {
      "action": "expectText",
      "selector": "tr:has-text('Pizza Artesanal') [data-product-photo-edit]",
      "name": "foto-anexada",
      "expected": "Trocar foto",
      "timeoutMs": 10000,
      "holdMs": 300
    }
  ]
}
