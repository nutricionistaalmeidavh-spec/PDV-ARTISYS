{
  "name": "09-suspender-retomar-venda",
  "title": "Suspender e retomar venda",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.setup",
      "scenario": "base"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 250
    },
    {
      "action": "click",
      "selector": "button[data-route='checkout']",
      "name": "abrir-balcao",
      "holdMs": 600
    },
    {
      "action": "fill",
      "selector": "#product-search",
      "name": "buscar-produto",
      "value": "Produto Tutorial",
      "holdMs": 500
    },
    {
      "action": "click",
      "selector": "[data-add-product='tutorial-product']",
      "name": "adicionar-produto",
      "holdMs": 700
    },
    {
      "action": "click",
      "selector": "#suspend-sale",
      "name": "suspender-venda",
      "holdMs": 800
    },
    {
      "action": "waitFor",
      "selector": "[data-resume]",
      "name": "venda-suspensa",
      "state": "visible",
      "timeoutMs": 10000,
      "holdMs": 600
    },
    {
      "action": "click",
      "selector": "[data-resume]",
      "name": "retomar-venda",
      "holdMs": 800
    },
    {
      "action": "expectText",
      "selector": ".cart-list",
      "name": "venda-retomada",
      "expected": "Produto Tutorial",
      "timeoutMs": 10000,
      "holdMs": 1000
    }
  ]
}
