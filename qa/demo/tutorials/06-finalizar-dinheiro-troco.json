{
  "name": "06-finalizar-dinheiro-troco",
  "title": "Finalizar em dinheiro e calcular troco",
  "metadata": {
    "qaAutoAdmin": true
  },
  "steps": [
    {
      "action": "authenticateLocalQa",
      "name": "entrar",
      "timeoutMs": 15000
    },
    {
      "action": "capability",
      "name": "tutorial.setup",
      "scenario": "cash-change"
    },
    {
      "action": "waitFor",
      "selector": "#app-topbar",
      "name": "app-ready",
      "state": "visible",
      "timeoutMs": 15000,
      "holdMs": 250
    },
    {
      "action": "click",
      "selector": "button[data-route='checkout']",
      "name": "abrir-balcao",
      "holdMs": 600
    },
    {
      "action": "fill",
      "selector": "#product-search",
      "name": "buscar-produto",
      "value": "Produto Tutorial",
      "holdMs": 500
    },
    {
      "action": "click",
      "selector": "[data-add-product='tutorial-product']",
      "name": "adicionar-produto",
      "holdMs": 700
    },
    {
      "action": "click",
      "selector": "[data-pay='cash']",
      "name": "pagar-dinheiro",
      "holdMs": 700
    },
    {
      "action": "waitFor",
      "selector": "#cash-received-value",
      "name": "troco-disponivel",
      "state": "visible",
      "timeoutMs": 10000,
      "holdMs": 400
    },
    {
      "action": "fill",
      "selector": "#cash-received-value",
      "name": "valor-recebido",
      "value": "20,00",
      "holdMs": 700
    },
    {
      "action": "expectText",
      "selector": "#cash-change-message",
      "name": "troco-calculado",
      "expected": "Troco a devolver:",
      "timeoutMs": 10000,
      "holdMs": 900
    },
    {
      "action": "click",
      "selector": "#confirm-payment",
      "name": "concluir-venda",
      "holdMs": 700
    },
    {
      "action": "expectText",
      "selector": ".cart-head",
      "name": "venda-concluida",
      "expected": "Itens da venda (0)",
      "timeoutMs": 10000,
      "holdMs": 900
    }
  ]
}
